import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Theme, KeyboardAction, StationBadge } from "../design-system.slint";

component ShellMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> description;
    callback activated();
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    height: 29px;
    min-width: 54px;
    background: pointer.has-hover ? Theme.surface-hover : transparent;
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea { clicked => { focus.focus(); root.activated(); } }
}

export component DesktopMenuBar inherits Rectangle {
    callback open-logbook();
    callback toggle-sidebar();
    callback open-tools();
    callback open-settings();
    callback toggle-theme();

    accessible-role: navigation;
    accessible-label: "Application menu";
    height: 30px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalBox {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-2xs;
        Text {
            text: "DHRL";
            width: 54px;
            color: Theme.text-muted;
            font-size: Theme.text-xs;
            font-weight: 800;
            vertical-alignment: center;
        }
        ShellMenuItem { label: "File"; description: "Return to the logbook"; activated => { root.open-logbook(); } }
        ShellMenuItem { label: "View"; description: "Expand or collapse navigation"; activated => { root.toggle-sidebar(); } }
        ShellMenuItem { label: "Tools"; description: "Open data tools"; activated => { root.open-tools(); } }
        ShellMenuItem { label: "Settings"; description: "Open application settings"; activated => { root.open-settings(); } }
        Rectangle { horizontal-stretch: 1; }
        ShellMenuItem { label: Theme.dark-mode ? "Light" : "Dark"; description: "Toggle the application color theme"; activated => { root.toggle-theme(); } }
    }
}

component SideNavItem inherits Rectangle {
    in property <string> short-label;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;
    height: 34px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.surface-selected : pointer.has-hover ? Theme.surface-hover : transparent;

    HorizontalBox {
        padding-left: root.collapsed ? 0px : Theme.space-sm;
        padding-right: root.collapsed ? 0px : Theme.space-sm;
        spacing: Theme.space-sm;
        Text {
            text: root.short-label;
            width: root.collapsed ? parent.width : 28px;
            color: root.active ? Theme.accent-strong : Theme.text-muted;
            font-size: Theme.text-xs;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if !root.collapsed : Text {
            text: root.label;
            color: root.active ? Theme.accent-strong : Theme.text-secondary;
            font-size: Theme.text-sm;
            font-weight: root.active ? 700 : 550;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea { clicked => { focus.focus(); root.activated(); } }
}

export component AppSidebar inherits Rectangle {
    in property <int> active-page;
    in property <bool> collapsed;
    callback navigate(int);
    callback toggle();

    accessible-role: navigation;
    accessible-label: "Primary navigation";
    width: root.collapsed ? 58px : 188px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalBox {
        spacing: 0px;
        Rectangle {
            height: 54px;
            background: Theme.surface-raised;
            HorizontalBox {
                padding-left: root.collapsed ? Theme.space-xs : Theme.space-md;
                padding-right: Theme.space-xs;
                spacing: Theme.space-sm;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-md;
                    background: Theme.primary;
                    Text { text: "D"; color: #ffffff; font-size: Theme.text-md; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                if !root.collapsed : VerticalBox {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    alignment: center;
                    Text { text: "Digital Ham Radio"; color: Theme.text-primary; font-size: Theme.text-xs; font-weight: 700; overflow: elide; }
                    Text { text: "Logbook"; color: Theme.text-muted; font-size: Theme.text-xs; overflow: elide; }
                }
                KeyboardAction { width: 28px; compact: true; label: root.collapsed ? ">" : "<"; description: root.collapsed ? "Expand sidebar" : "Collapse sidebar"; activated => { root.toggle(); } }
            }
        }

        VerticalBox {
            padding-left: Theme.space-xs;
            padding-right: Theme.space-xs;
            padding-top: Theme.space-sm;
            spacing: Theme.space-2xs;

            if !root.collapsed : Text { text: "OPERATION"; height: 22px; color: Theme.text-muted; font-size: 9px; font-weight: 800; vertical-alignment: center; }
            SideNavItem { short-label: "LOG"; label: "Logbook"; collapsed: root.collapsed; active: root.active-page == 0; activated => { root.navigate(0); } }
            SideNavItem { short-label: "+"; label: "New QSO"; collapsed: root.collapsed; active: root.active-page == 1; activated => { root.navigate(1); } }

            Rectangle { height: Theme.space-sm; background: transparent; }
            if !root.collapsed : Text { text: "DATA"; height: 22px; color: Theme.text-muted; font-size: 9px; font-weight: 800; vertical-alignment: center; }
            SideNavItem { short-label: "DB"; label: "Tools"; collapsed: root.collapsed; active: root.active-page == 2; activated => { root.navigate(2); } }

            Rectangle { height: Theme.space-sm; background: transparent; }
            if !root.collapsed : Text { text: "SYSTEM"; height: 22px; color: Theme.text-muted; font-size: 9px; font-weight: 800; vertical-alignment: center; }
            SideNavItem { short-label: "CFG"; label: "Settings"; collapsed: root.collapsed; active: root.active-page == 3; activated => { root.navigate(3); } }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

export component ContextBar inherits Rectangle {
    in property <string> section;
    in property <string> title;
    in property <string> meta;
    in property <string> callsign;

    accessible-role: banner;
    accessible-label: root.section + " " + root.title;
    height: 50px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalBox {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-md;
        spacing: Theme.space-md;
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 0px;
            alignment: center;
            Text { text: root.section; color: Theme.text-muted; font-size: 9px; font-weight: 800; }
            Text { text: root.title; color: Theme.text-primary; font-size: Theme.text-md; font-weight: 700; overflow: elide; }
        }
        if root.meta != "" : Text {
            text: root.meta;
            color: Theme.text-muted;
            font-size: Theme.text-xs;
            font-weight: 650;
            vertical-alignment: center;
        }
        StationBadge { width: root.callsign == "" ? 150px : 138px; callsign: root.callsign; }
    }
}
