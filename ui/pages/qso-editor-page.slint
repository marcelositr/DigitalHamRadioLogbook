import { LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, DataLabel, KeyboardAction, Panel, SectionTitle, Tag } from "../design-system.slint";

export component QsoEditorPage inherits VerticalBox {
    accessible-role: main;
    accessible-label: editing-id == "" ? "New QSO" : "Edit QSO";
    in-out property <string> band-text;
    in-out property <string> callsign-text;
    in-out property <string> datetime-text;
    in-out property <bool> discard-editor-visible;
    in-out property <string> dmr-access-type-text;
    in-out property <string> dmr-call-type-text;
    in-out property <string> dmr-color-code-text;
    in-out property <string> dmr-hotspot-text;
    in-out property <string> dmr-local-id-text;
    in-out property <string> dmr-network-text;
    in-out property <string> dmr-notes-text;
    in-out property <string> dmr-remote-id-text;
    in-out property <string> dmr-repeater-text;
    in-out property <string> dmr-talkgroup-text;
    in-out property <string> dmr-timeslot-text;
    in-out property <string> editing-id;
    in-out property <string> frequency-text;
    in-out property <string> ft8-audio-frequency-text;
    in-out property <string> ft8-final-message-text;
    in-out property <string> ft8-power-text;
    in-out property <string> ft8-protocol-text;
    in-out property <string> ft8-snr-received-text;
    in-out property <string> ft8-snr-sent-text;
    in-out property <string> ft8-source-software-text;
    in-out property <string> dstar-reflector-text;
    in-out property <string> dstar-module-text;
    in-out property <string> dstar-mycall-text;
    in-out property <string> dstar-urcall-text;
    in-out property <string> dstar-rpt1-text;
    in-out property <string> dstar-rpt2-text;
    in-out property <string> dstar-notes-text;
    in-out property <string> ysf-room-text;
    in-out property <string> ysf-wires-x-node-text;
    in-out property <string> ysf-repeater-text;
    in-out property <string> ysf-network-text;
    in-out property <string> ysf-access-type-text;
    in-out property <string> ysf-tx-dg-id-text;
    in-out property <string> ysf-rx-dg-id-text;
    in-out property <string> ysf-notes-text;
    in-out property <string> grid-text;
    in-out property <int> mode-kind;
    in-out property <string> mode-text;
    in-out property <string> name-text;
    in-out property <string> notes-text;
    in-out property <string> qth-text;
    in-out property <string> rst-received-text;
    in-out property <string> rst-sent-text;
    callback confirm-discard-editor();
    callback keep-editing();
    callback mode-input-changed(string);
    callback request-page(int);
    callback save-qso();
    callback save-and-new-qso();
    callback review-duplicate();
    callback save-duplicate-anyway();
    in-out property <bool> duplicate-warning-visible;
    in-out property <string> duplicate-warning-text;
    in property <bool> callsign-focus-request;
    changed callsign-focus-request => { callsign-input.focus(); }

    spacing: 0px;

    ScrollView {
        accessible-role: form;
        accessible-label: root.editing-id == "" ? "New QSO form" : "Edit QSO form";
        vertical-stretch: 1;

        VerticalBox {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            HorizontalBox {
                height: 28px;
                spacing: Theme.space-sm;
                Text {
                    text: root.editing-id == "" ? "Create a new contact" : "Editing an existing contact";
                    color: Theme.text-muted;
                    font-size: Theme.text-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Tag { width: 82px; height: 24px; text: root.mode-text == "" ? "Mode not set" : root.mode-text; accent: root.mode-text != ""; }
                DataLabel { text: "UTC"; }
                Text { text: "* Required"; color: Theme.text-muted; font-size: Theme.text-xs; font-weight: 550; vertical-alignment: center; }
            }

            Panel {
                raised: true;
                VerticalBox {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        SectionTitle { text: "Contact"; horizontal-stretch: 1; }
                        DataLabel { text: "Identity · time · carrier"; }
                    }
                    Rectangle { height: 1px; background: Theme.divider; }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox {
                            spacing: Theme.space-xs; horizontal-stretch: 2;
                            DataLabel { text: "Callsign  *"; }
                            callsign-input := LineEdit { accessible-label: "Callsign, required"; text <=> root.callsign-text; placeholder-text: "PU2XYZ"; }
                        }
                        VerticalBox {
                            spacing: Theme.space-xs; horizontal-stretch: 3;
                            DataLabel { text: "Date and time (UTC)  *"; }
                            LineEdit { accessible-label: "Date and time UTC, required"; text <=> root.datetime-text; placeholder-text: "YYYY-MM-DD HH:MM:SS UTC"; }
                        }
                        VerticalBox {
                            spacing: Theme.space-xs; horizontal-stretch: 2;
                            DataLabel { text: "Mode  *"; }
                            LineEdit {
                                accessible-label: "Mode, required";
                                text <=> root.mode-text;
                                placeholder-text: "DMR, FT8, M17...";
                                edited => { root.mode-input-changed(root.mode-text); }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox {
                            spacing: Theme.space-xs; horizontal-stretch: 3;
                            DataLabel { text: "Frequency (MHz)  *"; }
                            LineEdit { accessible-label: "Frequency in megahertz, required"; text <=> root.frequency-text; placeholder-text: "438.500"; }
                        }
                        VerticalBox {
                            spacing: Theme.space-xs; horizontal-stretch: 2;
                            DataLabel { text: "Band override"; }
                            LineEdit { accessible-label: "Band override"; text <=> root.band-text; placeholder-text: "Auto when empty"; }
                        }
                        VerticalBox {
                            spacing: Theme.space-xs; horizontal-stretch: 2;
                            DataLabel { text: "Grid locator"; }
                            LineEdit { accessible-label: "Grid locator"; text <=> root.grid-text; placeholder-text: "GG66AA"; }
                        }
                    }
                }
            }

            Panel {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    HorizontalBox {
                        SectionTitle { text: "Report and station"; horizontal-stretch: 1; }
                        DataLabel { text: "Signal · operator"; }
                    }
                    Rectangle { height: 1px; background: Theme.divider; }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "RST sent"; } LineEdit { text <=> root.rst-sent-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "RST received"; } LineEdit { text <=> root.rst-received-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Name"; } LineEdit { text <=> root.name-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "QTH"; } LineEdit { text <=> root.qth-text; } }
                    }
                }
            }

            if root.mode-kind == 1 : Panel {
                raised: true;
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        SectionTitle { text: "DMR details"; horizontal-stretch: 1; }
                        Tag { width: 54px; height: 22px; text: "DMR"; accent: true; }
                        DataLabel { text: "Digital voice path"; }
                    }
                    Rectangle { height: 1px; background: Theme.divider; }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Remote DMR ID"; } LineEdit { text <=> root.dmr-remote-id-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Local DMR ID"; } LineEdit { text <=> root.dmr-local-id-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Talkgroup"; } LineEdit { text <=> root.dmr-talkgroup-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Timeslot"; } LineEdit { text <=> root.dmr-timeslot-text; placeholder-text: "1 or 2"; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Color code"; } LineEdit { text <=> root.dmr-color-code-text; placeholder-text: "0–15"; } }
                    }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; DataLabel { text: "Network"; } LineEdit { text <=> root.dmr-network-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Call type"; } LineEdit { text <=> root.dmr-call-type-text; placeholder-text: "group or private"; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; DataLabel { text: "Access type"; } LineEdit { text <=> root.dmr-access-type-text; placeholder-text: "repeater, hotspot, or simplex"; } }
                    }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Repeater callsign"; } LineEdit { text <=> root.dmr-repeater-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Hotspot"; } LineEdit { text <=> root.dmr-hotspot-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "DMR notes"; } LineEdit { text <=> root.dmr-notes-text; } }
                    }
                }
            }

            if root.mode-kind == 2 : Panel {
                raised: true;
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        SectionTitle { text: "FT8 details"; horizontal-stretch: 1; }
                        Tag { width: 54px; height: 22px; text: "FT8"; accent: true; }
                        DataLabel { text: "Weak-signal exchange"; }
                    }
                    Rectangle { height: 1px; background: Theme.divider; }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "SNR sent (dB)"; } LineEdit { text <=> root.ft8-snr-sent-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "SNR received (dB)"; } LineEdit { text <=> root.ft8-snr-received-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Power (W)"; } LineEdit { text <=> root.ft8-power-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Audio frequency (Hz)"; } LineEdit { text <=> root.ft8-audio-frequency-text; } }
                    }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Source software"; } LineEdit { text <=> root.ft8-source-software-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Protocol"; } LineEdit { text <=> root.ft8-protocol-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Final message"; } LineEdit { text <=> root.ft8-final-message-text; } }
                    }
                }
            }

            if root.mode-kind == 3 : Panel {
                raised: true;
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        SectionTitle { text: "D-STAR details"; horizontal-stretch: 1; }
                        Tag { width: 64px; height: 22px; text: "D-STAR"; accent: true; }
                        DataLabel { text: "Digital voice routing"; }
                    }
                    Rectangle { height: 1px; background: Theme.divider; }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Reflector"; } LineEdit { text <=> root.dstar-reflector-text; placeholder-text: "REF001 C"; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "Module"; } LineEdit { text <=> root.dstar-module-text; placeholder-text: "A–Z or 0–9"; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "MYCALL"; } LineEdit { text <=> root.dstar-mycall-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "URCALL"; } LineEdit { text <=> root.dstar-urcall-text; placeholder-text: "CQCQCQ"; } }
                    }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "RPT1"; } LineEdit { text <=> root.dstar-rpt1-text; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "RPT2"; } LineEdit { text <=> root.dstar-rpt2-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "D-STAR notes"; } LineEdit { text <=> root.dstar-notes-text; } }
                    }
                }
            }

            if root.mode-kind == 4 : Panel {
                raised: true;
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        SectionTitle { text: "YSF / C4FM details"; horizontal-stretch: 1; }
                        Tag { width: 58px; height: 22px; text: "C4FM"; accent: true; }
                        DataLabel { text: "System Fusion routing"; }
                    }
                    Rectangle { height: 1px; background: Theme.divider; }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Room"; } LineEdit { text <=> root.ysf-room-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "WIRES-X node"; } LineEdit { text <=> root.ysf-wires-x-node-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Repeater"; } LineEdit { text <=> root.ysf-repeater-text; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Network"; } LineEdit { text <=> root.ysf-network-text; } }
                    }
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; DataLabel { text: "Access type"; } LineEdit { text <=> root.ysf-access-type-text; placeholder-text: "simplex, repeater, or hotspot"; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "TX DG-ID"; } LineEdit { text <=> root.ysf-tx-dg-id-text; placeholder-text: "0–99"; } }
                        VerticalBox { spacing: Theme.space-xs; DataLabel { text: "RX DG-ID"; } LineEdit { text <=> root.ysf-rx-dg-id-text; placeholder-text: "0–99"; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; DataLabel { text: "YSF notes"; } LineEdit { text <=> root.ysf-notes-text; } }
                    }
                }
            }

            Panel {
                VerticalBox {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    HorizontalBox {
                        SectionTitle { text: "Notes"; horizontal-stretch: 1; }
                        DataLabel { text: "Enter to save"; }
                    }
                    LineEdit {
                        accessible-label: "Contact notes";
                        accessible-description: "Press Enter to save the QSO";
                        text <=> root.notes-text;
                        placeholder-text: "Contact notes";
                        accepted => { root.save-qso(); }
                    }
                }
            }
            Rectangle { height: Theme.space-xs; }
        }
    }

    if root.duplicate-warning-visible : Rectangle {
        accessible-role: form;
        accessible-label: "Possible duplicate QSO actions";
        background: Theme.warning-surface;
        border-width: 1px;
        border-color: Theme.warning;
        HorizontalBox {
            padding: Theme.space-md; spacing: Theme.space-md;
            Rectangle { width: 3px; background: Theme.warning; }
            VerticalBox {
                spacing: Theme.space-2xs; horizontal-stretch: 1;
                Text { text: "Possible duplicate QSO"; color: Theme.warning; font-size: Theme.text-sm; font-weight: 600; }
                Text { text: root.duplicate-warning-text; color: Theme.text-secondary; font-size: Theme.text-xs; wrap: word-wrap; }
            }
            KeyboardAction { width: 82px; compact: true; label: "Review"; description: "Return to the unchanged QSO form without saving"; activated => { root.review-duplicate(); } }
            KeyboardAction { width: 108px; compact: true; primary: true; label: "Save anyway"; description: "Save this exact duplicate QSO"; activated => { root.save-duplicate-anyway(); } }
        }
    }

    if root.discard-editor-visible : Rectangle {
        background: Theme.warning-surface;
        border-width: 1px;
        border-color: Theme.warning;
        HorizontalBox {
            padding: Theme.space-md;
            spacing: Theme.space-md;
            Rectangle { width: 3px; background: Theme.warning; }
            VerticalBox {
                spacing: Theme.space-2xs;
                horizontal-stretch: 1;
                Text { text: "Discard unsaved changes?"; color: Theme.warning; font-size: Theme.text-sm; font-weight: 600; }
                Text { text: "Your changes to this QSO have not been saved."; color: Theme.text-secondary; font-size: Theme.text-xs; }
            }
            KeyboardAction { width: 108px; compact: true; label: "Continue editing"; description: "Return to the QSO editor"; activated => { root.keep-editing(); } }
            KeyboardAction { width: 110px; compact: true; danger: true; label: "Discard changes"; description: "Discard unsaved QSO changes"; activated => { root.confirm-discard-editor(); } }
        }
    }

    Rectangle {
        height: 48px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-subtle;
        HorizontalBox {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-lg;
            spacing: Theme.space-sm;
            DataLabel { text: "Enter"; }
            Text { text: "Save from Notes"; color: Theme.text-secondary; font-size: Theme.text-xs; vertical-alignment: center; }
            Rectangle { width: 1px; height: 18px; background: Theme.divider; }
            DataLabel { text: "Esc"; }
            Text { text: "Cancel / close"; color: Theme.text-secondary; font-size: Theme.text-xs; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.editing-id == "" : KeyboardAction {
                width: 116px; label: "Save & New"; description: "Save this QSO and open a clean new QSO form (Ctrl+Enter)";
                activated => { root.save-and-new-qso(); }
            }
            KeyboardAction { width: 76px; label: "Cancel"; description: "Cancel QSO editing"; activated => { root.request-page(0); } }
            KeyboardAction {
                width: 116px;
                label: root.editing-id == "" ? "Save QSO" : "Save changes";
                description: root.editing-id == "" ? "Save new QSO" : "Save QSO changes";
                primary: true;
                activated => { root.save-qso(); }
            }
        }
    }
}
