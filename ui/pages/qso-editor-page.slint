import { Button, GroupBox, HorizontalBox, ScrollView, StyleMetrics, VerticalBox } from "std-widgets.slint";
import { FormField } from "../design-system.slint";

export component QsoEditorPage inherits VerticalBox {
    accessible-role: main;
    accessible-label: root.editing-id == "" ? "New QSO" : "Edit QSO";

    in-out property <string> band-text;
    in-out property <string> callsign-text;
    in-out property <string> datetime-text;
    in-out property <bool> discard-editor-visible;
    in-out property <string> dmr-access-type-text;
    in-out property <string> dmr-call-type-text;
    in-out property <string> dmr-color-code-text;
    in-out property <string> dmr-hotspot-text;
    in-out property <string> dmr-local-id-text;
    in-out property <string> dmr-network-text;
    in-out property <string> dmr-notes-text;
    in-out property <string> dmr-remote-id-text;
    in-out property <string> dmr-repeater-text;
    in-out property <string> dmr-talkgroup-text;
    in-out property <string> dmr-timeslot-text;
    in-out property <string> editing-id;
    in-out property <string> frequency-text;
    in-out property <string> ft8-audio-frequency-text;
    in-out property <string> ft8-final-message-text;
    in-out property <string> ft8-power-text;
    in-out property <string> ft8-protocol-text;
    in-out property <string> ft8-snr-received-text;
    in-out property <string> ft8-snr-sent-text;
    in-out property <string> ft8-source-software-text;
    in-out property <string> dstar-reflector-text;
    in-out property <string> dstar-module-text;
    in-out property <string> dstar-mycall-text;
    in-out property <string> dstar-urcall-text;
    in-out property <string> dstar-rpt1-text;
    in-out property <string> dstar-rpt2-text;
    in-out property <string> dstar-notes-text;
    in-out property <string> ysf-room-text;
    in-out property <string> ysf-wires-x-node-text;
    in-out property <string> ysf-repeater-text;
    in-out property <string> ysf-network-text;
    in-out property <string> ysf-access-type-text;
    in-out property <string> ysf-tx-dg-id-text;
    in-out property <string> ysf-rx-dg-id-text;
    in-out property <string> ysf-notes-text;
    in-out property <string> grid-text;
    in-out property <int> mode-kind;
    in-out property <string> mode-text;
    in-out property <string> name-text;
    in-out property <string> notes-text;
    in-out property <string> qth-text;
    in-out property <string> rst-received-text;
    in-out property <string> rst-sent-text;

    callback confirm-discard-editor();
    callback keep-editing();
    callback mode-input-changed(string);
    callback request-page(int);
    callback save-qso();
    callback save-and-new-qso();
    callback review-duplicate();
    callback save-duplicate-anyway();

    in-out property <bool> duplicate-warning-visible;
    in-out property <string> duplicate-warning-text;
    in property <bool> callsign-focus-request;

    changed callsign-focus-request => { callsign-field.focus-editor(); }

    spacing: 0px;

    ScrollView {
        accessible-role: form;
        accessible-label: root.editing-id == "" ? "New QSO form" : "Edit QSO form";
        vertical-stretch: 1;

        VerticalBox {
            padding: StyleMetrics.layout-padding;
            spacing: StyleMetrics.layout-spacing;

            HorizontalBox {
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: root.editing-id == "" ? "New QSO" : "Edit QSO";
                        font-size: 20px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.editing-id == ""
                            ? "Create a contact record."
                            : "Update the selected contact record.";
                        opacity: 0.7;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.mode-text == "" ? "Mode not set" : root.mode-text + " · UTC";
                    vertical-alignment: center;
                    opacity: 0.7;
                }
            }

            GroupBox {
                title: "Contact";
                vertical-stretch: 0;

                VerticalBox {
                    HorizontalBox {
                        callsign-field := FormField {
                            label: "Callsign *";
                            input-accessible-label: "Callsign, required";
                            placeholder-text: "PU2XYZ";
                            text <=> root.callsign-text;
                            horizontal-stretch: 2;
                        }

                        FormField {
                            label: "Date and time UTC *";
                            input-accessible-label: "Date and time UTC, required";
                            placeholder-text: "YYYY-MM-DD HH:MM:SS";
                            text <=> root.datetime-text;
                            horizontal-stretch: 3;
                        }

                        FormField {
                            label: "Mode *";
                            input-accessible-label: "Mode, required";
                            placeholder-text: "DMR, FT8, D-STAR, C4FM...";
                            text <=> root.mode-text;
                            horizontal-stretch: 2;
                            edited => { root.mode-input-changed(root.mode-text); }
                        }
                    }

                    HorizontalBox {
                        FormField {
                            label: "Frequency (MHz) *";
                            input-accessible-label: "Frequency in megahertz, required";
                            placeholder-text: "438.500";
                            text <=> root.frequency-text;
                            horizontal-stretch: 2;
                        }

                        FormField {
                            label: "Band override";
                            input-accessible-label: "Band override";
                            placeholder-text: "Automatic when empty";
                            text <=> root.band-text;
                            horizontal-stretch: 1;
                        }

                        FormField {
                            label: "Grid locator";
                            input-accessible-label: "Grid locator";
                            placeholder-text: "GG66AA";
                            text <=> root.grid-text;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            GroupBox {
                title: "Station and report";
                vertical-stretch: 0;

                HorizontalBox {
                    FormField {
                        label: "RST sent";
                        text <=> root.rst-sent-text;
                        horizontal-stretch: 1;
                    }

                    FormField {
                        label: "RST received";
                        text <=> root.rst-received-text;
                        horizontal-stretch: 1;
                    }

                    FormField {
                        label: "Name";
                        text <=> root.name-text;
                        horizontal-stretch: 2;
                    }

                    FormField {
                        label: "QTH";
                        text <=> root.qth-text;
                        horizontal-stretch: 2;
                    }
                }
            }

            if root.mode-kind == 1 : GroupBox {
                title: "DMR";
                vertical-stretch: 0;

                VerticalBox {
                    HorizontalBox {
                        FormField {
                            label: "Remote DMR ID";
                            text <=> root.dmr-remote-id-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Local DMR ID";
                            text <=> root.dmr-local-id-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Talkgroup";
                            text <=> root.dmr-talkgroup-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Timeslot";
                            placeholder-text: "1 or 2";
                            text <=> root.dmr-timeslot-text;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalBox {
                        FormField {
                            label: "Color code";
                            placeholder-text: "0–15";
                            text <=> root.dmr-color-code-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Network";
                            text <=> root.dmr-network-text;
                            horizontal-stretch: 2;
                        }
                        FormField {
                            label: "Call type";
                            placeholder-text: "group or private";
                            text <=> root.dmr-call-type-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Access type";
                            placeholder-text: "repeater, hotspot, simplex";
                            text <=> root.dmr-access-type-text;
                            horizontal-stretch: 2;
                        }
                    }

                    HorizontalBox {
                        FormField {
                            label: "Repeater callsign";
                            text <=> root.dmr-repeater-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Hotspot";
                            text <=> root.dmr-hotspot-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "DMR notes";
                            text <=> root.dmr-notes-text;
                            horizontal-stretch: 2;
                        }
                    }
                }
            }

            if root.mode-kind == 2 : GroupBox {
                title: "FT8";
                vertical-stretch: 0;

                VerticalBox {
                    HorizontalBox {
                        FormField {
                            label: "SNR sent (dB)";
                            text <=> root.ft8-snr-sent-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "SNR received (dB)";
                            text <=> root.ft8-snr-received-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Power (W)";
                            text <=> root.ft8-power-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Audio frequency (Hz)";
                            text <=> root.ft8-audio-frequency-text;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalBox {
                        FormField {
                            label: "Source software";
                            text <=> root.ft8-source-software-text;
                            horizontal-stretch: 2;
                        }
                        FormField {
                            label: "Protocol";
                            text <=> root.ft8-protocol-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Final message";
                            text <=> root.ft8-final-message-text;
                            horizontal-stretch: 2;
                        }
                    }
                }
            }

            if root.mode-kind == 3 : GroupBox {
                title: "D-STAR";
                vertical-stretch: 0;

                VerticalBox {
                    HorizontalBox {
                        FormField {
                            label: "Reflector";
                            placeholder-text: "REF001 C";
                            text <=> root.dstar-reflector-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Module";
                            placeholder-text: "A–Z or 0–9";
                            text <=> root.dstar-module-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "MYCALL";
                            text <=> root.dstar-mycall-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "URCALL";
                            placeholder-text: "CQCQCQ";
                            text <=> root.dstar-urcall-text;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalBox {
                        FormField {
                            label: "RPT1";
                            text <=> root.dstar-rpt1-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "RPT2";
                            text <=> root.dstar-rpt2-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "D-STAR notes";
                            text <=> root.dstar-notes-text;
                            horizontal-stretch: 2;
                        }
                    }
                }
            }

            if root.mode-kind == 4 : GroupBox {
                title: "YSF / C4FM";
                vertical-stretch: 0;

                VerticalBox {
                    HorizontalBox {
                        FormField {
                            label: "Room";
                            text <=> root.ysf-room-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "WIRES-X node";
                            text <=> root.ysf-wires-x-node-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Repeater";
                            text <=> root.ysf-repeater-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "Network";
                            text <=> root.ysf-network-text;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalBox {
                        FormField {
                            label: "Access type";
                            placeholder-text: "simplex, repeater, hotspot";
                            text <=> root.ysf-access-type-text;
                            horizontal-stretch: 2;
                        }
                        FormField {
                            label: "TX DG-ID";
                            placeholder-text: "0–99";
                            text <=> root.ysf-tx-dg-id-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "RX DG-ID";
                            placeholder-text: "0–99";
                            text <=> root.ysf-rx-dg-id-text;
                            horizontal-stretch: 1;
                        }
                        FormField {
                            label: "YSF notes";
                            text <=> root.ysf-notes-text;
                            horizontal-stretch: 2;
                        }
                    }
                }
            }

            GroupBox {
                title: "Notes";
                vertical-stretch: 0;

                FormField {
                    label: "Contact notes";
                    input-accessible-label: "Contact notes";
                    placeholder-text: "Optional notes";
                    text <=> root.notes-text;
                    accepted => { root.save-qso(); }
                }
            }
        }
    }

    if root.duplicate-warning-visible : GroupBox {
        title: "Possible duplicate QSO";
        vertical-stretch: 0;

        HorizontalBox {
            Text {
                text: root.duplicate-warning-text;
                horizontal-stretch: 1;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            Button {
                text: "Review";
                clicked => { root.review-duplicate(); }
            }

            Button {
                text: "Save anyway";
                primary: true;
                clicked => { root.save-duplicate-anyway(); }
            }
        }
    }

    if root.discard-editor-visible : GroupBox {
        title: "Discard unsaved changes?";
        vertical-stretch: 0;

        HorizontalBox {
            Text {
                text: "Your changes to this QSO have not been saved.";
                horizontal-stretch: 1;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            Button {
                text: "Continue editing";
                clicked => { root.keep-editing(); }
            }

            Button {
                text: "Discard changes";
                primary: true;
                clicked => { root.confirm-discard-editor(); }
            }
        }
    }

    HorizontalBox {
        padding-left: StyleMetrics.layout-padding;
        padding-right: StyleMetrics.layout-padding;
        padding-top: StyleMetrics.layout-padding;
        padding-bottom: StyleMetrics.layout-padding;

        Text {
            text: "Ctrl+S Save · Ctrl+Enter Save & New · Esc Cancel";
            opacity: 0.7;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        if root.editing-id == "" : Button {
            text: "Save & New";
            clicked => { root.save-and-new-qso(); }
        }

        Button {
            text: "Cancel";
            clicked => { root.request-page(0); }
        }

        Button {
            text: root.editing-id == "" ? "Save QSO" : "Save changes";
            primary: true;
            clicked => { root.save-qso(); }
        }
    }
}
