import { Button, ComboBox, GroupBox, HorizontalBox, LineEdit, ScrollView, StyleMetrics, VerticalBox } from "std-widgets.slint";
import { Appearance } from "../appearance.slint";

export component SettingsPage inherits ScrollView {
    accessible-role: main;
    accessible-label: "Settings";

    in-out property <string> callsign-url-text;
    in-out property <string> grid-url-text;
    in-out property <string> local-callsign-text;

    callback restore-external-link-defaults();
    callback save-external-links();
    callback save-local-callsign();

    vertical-stretch: 1;

    VerticalBox {
        padding: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;

        VerticalBox {
            spacing: 2px;
            Text {
                text: "Settings";
                font-size: 20px;
                font-weight: 600;
            }
            Text {
                text: "Appearance, station identity and optional external lookup services.";
                opacity: 0.7;
                wrap: word-wrap;
            }
        }

        GroupBox {
            title: "Appearance";
            vertical-stretch: 0;

            VerticalBox {
                Text {
                    text: "The application uses the Fluent style. Choose whether its colors follow the desktop or stay light or dark.";
                    wrap: word-wrap;
                    opacity: 0.8;
                }

                HorizontalBox {
                    Text {
                        text: "Color scheme";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ComboBox {
                        accessible-label: "Application color scheme";
                        model: ["System", "Light", "Dark"];
                        current-index <=> Appearance.color-scheme-index;
                        horizontal-stretch: 0;
                        selected(value) => {
                            Appearance.color-scheme-selected(self.current-index);
                        }
                    }
                }

                Text {
                    text: Appearance.color-scheme-index == 0
                        ? "System follows the light or dark preference reported by the desktop."
                        : Appearance.color-scheme-index == 1
                            ? "Light keeps the application in light mode regardless of the desktop setting."
                            : "Dark keeps the application in dark mode regardless of the desktop setting.";
                    wrap: word-wrap;
                    opacity: 0.7;
                }
            }
        }

        GroupBox {
            title: "Local station";
            vertical-stretch: 0;

            VerticalBox {
                Text {
                    text: "The station callsign appears throughout the application and is stored in the local configuration.";
                    wrap: word-wrap;
                    opacity: 0.8;
                }

                HorizontalBox {
                    VerticalBox {
                        horizontal-stretch: 1;
                        Text { text: "Station callsign"; }
                        LineEdit {
                            accessible-label: "Local station callsign";
                            text <=> root.local-callsign-text;
                            placeholder-text: "Local callsign";
                        }
                    }

                    Button {
                        text: "Save station";
                        primary: true;
                        clicked => { root.save-local-callsign(); }
                    }
                }
            }
        }

        GroupBox {
            title: "External lookup links";
            vertical-stretch: 0;

            VerticalBox {
                Text {
                    text: "These services are optional. Opening a lookup sends only the selected callsign or grid locator to the configured website.";
                    wrap: word-wrap;
                }

                VerticalBox {
                    Text { text: "Callsign URL template"; }
                    Text {
                        text: "Must include {callsign}.";
                        opacity: 0.7;
                    }
                    LineEdit {
                        accessible-label: "Callsign lookup URL template";
                        accessible-description: "Must contain the callsign placeholder";
                        text <=> root.callsign-url-text;
                    }
                }

                VerticalBox {
                    Text { text: "Grid URL template"; }
                    Text {
                        text: "Must include {grid}.";
                        opacity: 0.7;
                    }
                    LineEdit {
                        accessible-label: "Grid lookup URL template";
                        accessible-description: "Must contain the grid placeholder";
                        text <=> root.grid-url-text;
                    }
                }

                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Restore defaults";
                        clicked => { root.restore-external-link-defaults(); }
                    }

                    Button {
                        text: "Save links";
                        primary: true;
                        clicked => { root.save-external-links(); }
                    }
                }
            }
        }

        Text {
            text: "Logbook data remains local. External websites open only after an explicit lookup action.";
            opacity: 0.7;
            wrap: word-wrap;
        }
    }
}
