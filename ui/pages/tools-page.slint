import { Button, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, PageTitle, SectionTitle } from "../design-system.slint";

export component ToolsPage inherits ScrollView {
    accessible-role: main;
    accessible-label: "Tools";
    in-out property <string> adif-path-text;
    in-out property <int> adif-preview-duplicates;
    in-out property <int> adif-preview-invalid;
    in-out property <string> adif-preview-modes;
    in-out property <string> adif-preview-bands;
    in-out property <string> adif-preview-date-range;
    in-out property <string> adif-preview-invalid-details;
    in-out property <int> adif-preview-new;
    in-out property <int> adif-preview-total;
    in-out property <bool> adif-preview-visible;
    in-out property <string> backup-path-text;
    callback backup-database();
    callback cancel-adif-import();
    callback choose-adif-export();
    callback choose-adif-import();
    callback choose-backup-destination();
    callback confirm-adif-import();
    callback export-adif();
    callback invalidate-adif-preview();
    callback preview-adif();

            vertical-stretch: 1;
            VerticalBox {
                padding: 18px; spacing: 18px;
                PageTitle { text: "Tools"; }
                Rectangle {
                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                    VerticalBox {
                        padding: Theme.space-lg; spacing: Theme.space-sm;
                        SectionTitle { text: "ADIF IMPORT AND EXPORT"; }
                        Text { text: "Exchange logbook data safely. Import is transactional and export never overwrites an existing file."; color: Theme.text-secondary; }
                        HorizontalBox {
                            spacing: Theme.space-sm;
                            LineEdit { accessible-label: "ADIF import or export path"; text <=> root.adif-path-text; placeholder-text: "/path/to/logbook.adi"; horizontal-stretch: 1; edited => { root.invalidate-adif-preview(); } }
                            Button { text: "Choose import…"; clicked => { root.invalidate-adif-preview(); root.choose-adif-import(); } }
                            Button { text: "Choose export…"; clicked => { root.invalidate-adif-preview(); root.choose-adif-export(); } }
                        }
                        HorizontalBox {
                            spacing: Theme.space-sm;
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "Preview import"; clicked => { root.preview-adif(); } }
                            Button { text: "Export ADIF"; primary: true; clicked => { root.export-adif(); } }
                        }
                        if root.adif-preview-visible : Rectangle {
                            background: Theme.surface-raised; border-width: 1px; border-color: root.adif-preview-invalid > 0 ? Theme.warning : Theme.accent-secondary; border-radius: Theme.radius-md;
                            VerticalBox {
                                padding: Theme.space-md; spacing: Theme.space-sm;
                                Text { text: "ADIF IMPORT PREVIEW"; color: Theme.accent; font-weight: 700; }
                                HorizontalBox {
                                    spacing: Theme.space-lg;
                                    Text { text: "Total  " + root.adif-preview-total; color: Theme.text-secondary; }
                                    Text { text: "New  " + root.adif-preview-new; color: Theme.success; font-weight: 700; }
                                    Text { text: "Duplicates  " + root.adif-preview-duplicates; color: Theme.text-muted; }
                                    Text { text: "Invalid  " + root.adif-preview-invalid; color: root.adif-preview-invalid > 0 ? Theme.warning : Theme.text-muted; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { text: "Modes  " + root.adif-preview-modes; color: Theme.text-secondary; wrap: word-wrap; }
                                Text { text: "Bands  " + root.adif-preview-bands; color: Theme.text-secondary; wrap: word-wrap; }
                                Text { text: "UTC range  " + root.adif-preview-date-range; color: Theme.text-secondary; wrap: word-wrap; }
                                Rectangle {
                                    background: Theme.background; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                                    VerticalBox {
                                        padding: Theme.space-sm; spacing: Theme.space-xs;
                                        Text { text: "DUPLICATE RULE"; color: Theme.accent-secondary; font-size: 11px; font-weight: 700; }
                                        Text { text: "Same normalized callsign + start UTC + frequency + mode. Existing QSOs and later repetitions in this file are skipped."; color: Theme.text-muted; wrap: word-wrap; }
                                    }
                                }
                                if root.adif-preview-invalid > 0 : Rectangle {
                                    background: Theme.background; border-width: 1px; border-color: Theme.warning; border-radius: Theme.radius-sm;
                                    VerticalBox {
                                        padding: Theme.space-sm; spacing: Theme.space-xs;
                                        Text { text: "INVALID RECORDS — NOT IMPORTED"; color: Theme.warning; font-size: 11px; font-weight: 700; }
                                        Text { text: root.adif-preview-invalid-details; color: Theme.text-secondary; wrap: word-wrap; }
                                    }
                                }
                                Text { text: "Preview only — the database has not been changed."; color: Theme.text-muted; }
                                HorizontalBox {
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { text: "Cancel"; clicked => { root.cancel-adif-import(); } }
                                    Button { text: "Import " + root.adif-preview-new + " QSO(s)"; primary: true; enabled: root.adif-preview-new > 0; clicked => { root.confirm-adif-import(); } }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                    VerticalBox {
                        padding: Theme.space-lg; spacing: Theme.space-sm;
                        SectionTitle { text: "DATABASE BACKUP"; }
                        Text { text: "Create a consistent SQLite snapshot. The destination must not already exist."; color: Theme.text-secondary; }
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit { accessible-label: "Database backup destination"; text <=> root.backup-path-text; placeholder-text: "/path/to/logbook-backup.sqlite3"; horizontal-stretch: 1; }
                            Button { text: "Choose destination…"; clicked => { root.choose-backup-destination(); } }
                            Button { text: "Create backup"; primary: true; clicked => { root.backup-database(); } }
                        }
                    }
                }
            }
        }
