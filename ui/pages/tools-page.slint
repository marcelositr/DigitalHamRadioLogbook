import { Button, GroupBox, HorizontalBox, LineEdit, ScrollView, StyleMetrics, VerticalBox } from "std-widgets.slint";

export component ToolsPage inherits ScrollView {
    accessible-role: main;
    accessible-label: "Tools";

    in-out property <string> adif-path-text;
    in-out property <int> adif-preview-duplicates;
    in-out property <int> adif-preview-invalid;
    in-out property <string> adif-preview-modes;
    in-out property <string> adif-preview-bands;
    in-out property <string> adif-preview-date-range;
    in-out property <string> adif-preview-invalid-details;
    in-out property <int> adif-preview-new;
    in-out property <int> adif-preview-total;
    in-out property <bool> adif-preview-visible;
    in-out property <string> backup-path-text;
    in-out property <bool> database-report-visible;
    in-out property <string> database-report-title;
    in-out property <string> database-report-text;
    in-out property <int> database-report-kind;

    callback backup-database();
    callback check-data-health();
    callback cancel-adif-import();
    callback choose-adif-export();
    callback choose-adif-import();
    callback choose-backup-destination();
    callback confirm-adif-import();
    callback export-adif();
    callback export-current-adif();
    callback invalidate-adif-preview();
    callback preview-adif();
    callback verify-backup();

    vertical-stretch: 1;

    VerticalBox {
        padding: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;

        VerticalBox {
            spacing: 2px;
            Text {
                text: "Tools";
                font-size: 20px;
                font-weight: 600;
            }
            Text {
                text: "Import and export ADIF, inspect data health, and manage SQLite backups.";
                opacity: 0.7;
                wrap: word-wrap;
            }
        }

        GroupBox {
            title: "ADIF import and export";
            vertical-stretch: 0;

            VerticalBox {
                Text {
                    text: "ADIF is the interoperability format for exchanging logbook records.";
                    wrap: word-wrap;
                    opacity: 0.8;
                }

                Text { text: "ADIF file"; }

                HorizontalBox {
                    LineEdit {
                        accessible-label: "ADIF import or export path";
                        text <=> root.adif-path-text;
                        placeholder-text: "/path/to/logbook.adi";
                        horizontal-stretch: 1;
                        edited => { root.invalidate-adif-preview(); }
                    }

                    Button {
                        text: "Select import";
                        clicked => {
                            root.invalidate-adif-preview();
                            root.choose-adif-import();
                        }
                    }

                    Button {
                        text: "Select export";
                        clicked => {
                            root.invalidate-adif-preview();
                            root.choose-adif-export();
                        }
                    }
                }

                HorizontalBox {
                    Text {
                        text: "Import is transactional. Export never overwrites an existing file.";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        opacity: 0.7;
                    }

                    Button {
                        text: "Preview import";
                        clicked => { root.preview-adif(); }
                    }

                    Button {
                        text: "Export all QSOs";
                        clicked => { root.export-adif(); }
                    }

                    Button {
                        text: "Export current results";
                        primary: true;
                        clicked => { root.export-current-adif(); }
                    }
                }

                if root.adif-preview-visible : VerticalBox {
                    spacing: StyleMetrics.layout-spacing;

                    Text {
                        text: "Import preview";
                        font-size: 16px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Preview only. The database has not been changed.";
                        opacity: 0.7;
                    }

                    HorizontalBox {
                        VerticalBox {
                            horizontal-stretch: 1;
                            Text { text: "Total"; opacity: 0.7; }
                            Text { text: root.adif-preview-total; font-size: 18px; font-weight: 600; }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            Text { text: "New"; opacity: 0.7; }
                            Text { text: root.adif-preview-new; font-size: 18px; font-weight: 600; }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            Text { text: "Duplicates"; opacity: 0.7; }
                            Text { text: root.adif-preview-duplicates; font-size: 18px; font-weight: 600; }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            Text { text: "Invalid"; opacity: 0.7; }
                            Text { text: root.adif-preview-invalid; font-size: 18px; font-weight: 600; }
                        }
                    }

                    VerticalBox {
                        Text { text: "Modes"; font-weight: 600; }
                        Text { text: root.adif-preview-modes; wrap: word-wrap; }
                    }

                    VerticalBox {
                        Text { text: "Bands"; font-weight: 600; }
                        Text { text: root.adif-preview-bands; wrap: word-wrap; }
                    }

                    VerticalBox {
                        Text { text: "UTC range"; font-weight: 600; }
                        Text { text: root.adif-preview-date-range; wrap: word-wrap; }
                    }

                    Text {
                        text: "Duplicate rule: same normalized callsign + start UTC + frequency + mode. Existing QSOs and later repetitions in the same file are skipped.";
                        wrap: word-wrap;
                        opacity: 0.7;
                    }

                    if root.adif-preview-invalid > 0 : VerticalBox {
                        Text {
                            text: "Invalid records will not be imported";
                            font-weight: 600;
                        }

                        Text {
                            text: root.adif-preview-invalid-details;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalBox {
                        Text {
                            text: root.adif-preview-new > 0
                                ? root.adif-preview-new + " QSO(s) ready to import"
                                : "No new QSOs available to import";
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Cancel";
                            clicked => { root.cancel-adif-import(); }
                        }

                        Button {
                            text: "Import " + root.adif-preview-new + " QSO(s)";
                            primary: true;
                            enabled: root.adif-preview-new > 0;
                            clicked => { root.confirm-adif-import(); }
                        }
                    }
                }
            }
        }

        GroupBox {
            title: "Data health";
            vertical-stretch: 0;

            HorizontalBox {
                Text {
                    text: "Read-only checks for SQLite integrity, foreign keys, schema objects, migration history, and mode metadata consistency.";
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                Button {
                    text: "Check data health";
                    primary: true;
                    clicked => { root.check-data-health(); }
                }
            }
        }

        if root.database-report-visible : GroupBox {
            title: root.database-report-title;
            vertical-stretch: 0;

            Text {
                accessible-label: "Database diagnostic report";
                text: root.database-report-text;
                wrap: word-wrap;
            }
        }

        GroupBox {
            title: "Database backup";
            vertical-stretch: 0;

            VerticalBox {
                Text {
                    text: "Create a validated SQLite snapshot, or verify an existing backup without restoring it.";
                    wrap: word-wrap;
                    opacity: 0.8;
                }

                Text { text: "Backup destination"; }

                HorizontalBox {
                    LineEdit {
                        accessible-label: "Database backup destination";
                        text <=> root.backup-path-text;
                        placeholder-text: "/path/to/logbook-backup.sqlite3";
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Select destination";
                        clicked => { root.choose-backup-destination(); }
                    }

                    Button {
                        text: "Create backup";
                        primary: true;
                        clicked => { root.backup-database(); }
                    }
                }

                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Verify existing backup";
                        clicked => { root.verify-backup(); }
                    }
                }
            }
        }
    }
}
