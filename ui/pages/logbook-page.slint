import { Button, GroupBox, HorizontalBox, LineEdit, ListView, Palette, StyleMetrics, VerticalBox } from "std-widgets.slint";
import { EmptyState, FormField, TextAction } from "../design-system.slint";
import { QsoRow } from "../models/qso-types.slint";

export component LogbookPage inherits VerticalBox {
    accessible-role: main;
    accessible-label: "Logbook";

    in-out property <int> active-filter;
    in-out property <int> active-page;
    in-out property <string> band-text;
    in-out property <string> callsign-text;
    in-out property <string> datetime-text;
    in-out property <string> dmr-access-type-text;
    in-out property <string> dmr-call-type-text;
    in-out property <string> dmr-color-code-text;
    in-out property <string> dmr-filter-hotspot-text;
    in-out property <string> dmr-filter-id-text;
    in-out property <string> dmr-filter-network-text;
    in-out property <string> dmr-filter-repeater-text;
    in-out property <string> dmr-filter-talkgroup-text;
    in-out property <string> dmr-filter-timeslot-text;
    in-out property <string> dmr-hotspot-text;
    in-out property <string> dmr-local-id-text;
    in-out property <string> dmr-network-text;
    in-out property <string> dmr-notes-text;
    in-out property <string> dmr-remote-id-text;
    in-out property <string> dmr-repeater-text;
    in-out property <string> dmr-talkgroup-text;
    in-out property <string> dmr-timeslot-text;
    in-out property <string> editing-id;
    in-out property <bool> filters-applied;
    in-out property <bool> filters-expanded;
    in-out property <string> frequency-text;
    in-out property <string> ft8-audio-frequency-text;
    in-out property <string> ft8-filter-band-text;
    in-out property <string> ft8-filter-callsign-text;
    in-out property <string> ft8-filter-end-text;
    in-out property <string> ft8-filter-grid-text;
    in-out property <string> ft8-filter-max-snr-text;
    in-out property <string> ft8-filter-min-snr-text;
    in-out property <string> ft8-filter-start-text;
    in-out property <string> ft8-final-message-text;
    in-out property <string> ft8-power-text;
    in-out property <string> ft8-protocol-text;
    in-out property <string> ft8-snr-received-text;
    in-out property <string> ft8-snr-sent-text;
    in-out property <string> ft8-source-software-text;
    in-out property <string> dstar-reflector-text;
    in-out property <string> dstar-module-text;
    in-out property <string> dstar-mycall-text;
    in-out property <string> dstar-urcall-text;
    in-out property <string> dstar-rpt1-text;
    in-out property <string> dstar-rpt2-text;
    in-out property <string> dstar-notes-text;
    in-out property <string> dstar-filter-reflector-text;
    in-out property <string> dstar-filter-module-text;
    in-out property <string> dstar-filter-rpt1-text;
    in-out property <string> ysf-room-text;
    in-out property <string> ysf-wires-x-node-text;
    in-out property <string> ysf-repeater-text;
    in-out property <string> ysf-network-text;
    in-out property <string> ysf-access-type-text;
    in-out property <string> ysf-tx-dg-id-text;
    in-out property <string> ysf-rx-dg-id-text;
    in-out property <string> ysf-notes-text;
    in-out property <string> ysf-filter-room-text;
    in-out property <string> ysf-filter-node-text;
    in-out property <string> ysf-filter-dg-id-text;
    in-out property <string> grid-text;
    in-out property <string> mode-text;
    in-out property <string> name-text;
    in-out property <string> notes-text;
    in-out property <string> pending-delete-id;
    in-out property <string> pending-delete-label;
    in-out property <[QsoRow]> qsos;
    in-out property <int> logbook-page-offset;
    in-out property <int> logbook-page-limit;
    in-out property <int> logbook-page-total;
    in-out property <int> logbook-page-number;
    in-out property <int> logbook-page-count;
    in-out property <string> qth-text;
    in-out property <string> rst-received-text;
    in-out property <string> rst-sent-text;
    in-out property <string> search-text;

    callback clear-dmr-filter();
    callback clear-ft8-filter();
    callback clear-dstar-filter();
    callback clear-ysf-filter();
    callback delete-qso(string);
    callback editor-opened();
    callback filter-dmr();
    callback filter-ft8();
    callback filter-dstar();
    callback filter-ysf();
    callback mode-input-changed(string);
    callback previous-logbook-page();
    callback next-logbook-page();
    callback open-callsign-lookup(string);
    callback open-grid-lookup(string);
    callback request-page(int);
    callback search-qso(string);

    in property <bool> search-focus-request;
    changed search-focus-request => { search-input.focus(); }

    property <length> table-padding: StyleMetrics.layout-padding / 2;
    property <length> utc-column-width: 124px;
    property <length> callsign-column-width: 96px;
    property <length> mode-column-width: 60px;
    property <length> frequency-column-width: 96px;
    property <length> band-column-width: 48px;
    property <length> grid-column-width: 64px;

    padding: StyleMetrics.layout-padding;
    spacing: StyleMetrics.layout-spacing / 2;

    HorizontalBox {
        VerticalBox {
            spacing: 2px;
            Text { text: "Logbook"; font-size: 20px; font-weight: 600; }
            Text {
                text: root.logbook-page-total == 1 ? "1 contact" : root.logbook-page-total + " contacts";
                opacity: 0.7;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "New QSO"; primary: true; clicked => { root.request-page(1); } }
    }

    HorizontalBox {
        spacing: StyleMetrics.layout-spacing / 2;
        accessible-role: search;
        accessible-label: "Search logbook";
        search-input := LineEdit {
            accessible-label: "Search logbook by callsign or mode";
            text <=> root.search-text;
            placeholder-text: "Search callsign or mode";
            horizontal-stretch: 1;
            accepted => {
                root.active-filter = 0;
                root.filters-applied = false;
                root.search-qso(root.search-text);
            }
        }
        Button {
            text: "Search";
            primary: true;
            clicked => {
                root.active-filter = 0;
                root.filters-applied = false;
                root.search-qso(root.search-text);
            }
        }
        Button {
            text: "Clear";
            enabled: root.search-text != "";
            clicked => {
                root.search-text = "";
                root.active-filter = 0;
                root.filters-applied = false;
                root.search-qso("");
            }
        }
        Button { text: root.filters-expanded ? "Close filters" : "Filters"; clicked => { root.filters-expanded = !root.filters-expanded; } }
    }

    if root.filters-applied : HorizontalBox {
        Text {
            text: root.active-filter == 1 ? "DMR filter applied"
                : root.active-filter == 2 ? "FT8 filter applied"
                : root.active-filter == 3 ? "D-STAR filter applied"
                : root.active-filter == 4 ? "YSF/C4FM filter applied"
                : "Filtered view";
            font-weight: 600;
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Clear filter";
            clicked => {
                if root.active-filter == 1 { root.clear-dmr-filter(); }
                else if root.active-filter == 2 { root.clear-ft8-filter(); }
                else if root.active-filter == 3 { root.clear-dstar-filter(); }
                else if root.active-filter == 4 { root.clear-ysf-filter(); }
            }
        }
    }

    if root.filters-expanded : GroupBox {
        title: "Filters";
        vertical-stretch: 0;
        VerticalBox {
            spacing: StyleMetrics.layout-spacing / 2;
            HorizontalBox {
                Text { text: "Mode"; vertical-alignment: center; }
                Button {
                    text: "All";
                    primary: root.active-filter == 0;
                    clicked => {
                        root.active-filter = 0;
                        root.filters-applied = false;
                        root.search-qso(root.search-text);
                    }
                }
                Button { text: "DMR"; primary: root.active-filter == 1; clicked => { root.active-filter = 1; } }
                Button { text: "FT8"; primary: root.active-filter == 2; clicked => { root.active-filter = 2; } }
                Button { text: "D-STAR"; primary: root.active-filter == 3; clicked => { root.active-filter = 3; } }
                Button { text: "YSF/C4FM"; primary: root.active-filter == 4; clicked => { root.active-filter = 4; } }
                Rectangle { horizontal-stretch: 1; }
            }

            if root.active-filter == 0 : Text { text: "Select a digital mode to show its advanced filters."; opacity: 0.7; }

            if root.active-filter == 1 : VerticalBox {
                HorizontalBox {
                    FormField { label: "DMR ID"; text <=> root.dmr-filter-id-text; horizontal-stretch: 1; }
                    FormField { label: "Talkgroup"; text <=> root.dmr-filter-talkgroup-text; horizontal-stretch: 1; }
                    FormField { label: "Network"; text <=> root.dmr-filter-network-text; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    FormField { label: "Timeslot"; text <=> root.dmr-filter-timeslot-text; horizontal-stretch: 1; }
                    FormField { label: "Repeater callsign"; text <=> root.dmr-filter-repeater-text; horizontal-stretch: 1; }
                    FormField { label: "Hotspot"; text <=> root.dmr-filter-hotspot-text; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Clear"; clicked => { root.clear-dmr-filter(); } }
                    Button { text: "Apply filter"; primary: true; clicked => { root.filter-dmr(); } }
                }
            }

            if root.active-filter == 2 : VerticalBox {
                spacing: StyleMetrics.layout-spacing / 2;
                HorizontalBox {
                    FormField { label: "Callsign"; text <=> root.ft8-filter-callsign-text; horizontal-stretch: 2; }
                    FormField { label: "Grid"; text <=> root.ft8-filter-grid-text; horizontal-stretch: 1; }
                    FormField { label: "Band"; text <=> root.ft8-filter-band-text; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    FormField { label: "Start UTC"; placeholder-text: "YYYY-MM-DD HH:MM:SS"; text <=> root.ft8-filter-start-text; horizontal-stretch: 1; }
                    FormField { label: "End UTC"; placeholder-text: "YYYY-MM-DD HH:MM:SS"; text <=> root.ft8-filter-end-text; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    FormField { label: "Min SNR"; text <=> root.ft8-filter-min-snr-text; horizontal-stretch: 1; }
                    FormField { label: "Max SNR"; text <=> root.ft8-filter-max-snr-text; horizontal-stretch: 1; }
                    Rectangle { horizontal-stretch: 2; }
                    Button { text: "Clear"; clicked => { root.clear-ft8-filter(); } }
                    Button { text: "Apply filter"; primary: true; clicked => { root.filter-ft8(); } }
                }
            }

            if root.active-filter == 3 : HorizontalBox {
                FormField { label: "Reflector"; text <=> root.dstar-filter-reflector-text; horizontal-stretch: 1; }
                FormField { label: "Module"; text <=> root.dstar-filter-module-text; horizontal-stretch: 1; }
                FormField { label: "RPT1"; text <=> root.dstar-filter-rpt1-text; horizontal-stretch: 1; }
                VerticalBox {
                    vertical-stretch: 0;
                    Text { text: "Actions"; opacity: 0.7; }
                    HorizontalBox {
                        Button { text: "Clear"; clicked => { root.clear-dstar-filter(); } }
                        Button { text: "Apply filter"; primary: true; clicked => { root.filter-dstar(); } }
                    }
                }
            }

            if root.active-filter == 4 : HorizontalBox {
                FormField { label: "Room"; text <=> root.ysf-filter-room-text; horizontal-stretch: 1; }
                FormField { label: "WIRES-X node"; text <=> root.ysf-filter-node-text; horizontal-stretch: 1; }
                FormField { label: "DG-ID"; text <=> root.ysf-filter-dg-id-text; horizontal-stretch: 1; }
                VerticalBox {
                    vertical-stretch: 0;
                    Text { text: "Actions"; opacity: 0.7; }
                    HorizontalBox {
                        Button { text: "Clear"; clicked => { root.clear-ysf-filter(); } }
                        Button { text: "Apply filter"; primary: true; clicked => { root.filter-ysf(); } }
                    }
                }
            }
        }
    }

    HorizontalBox {
        padding-left: root.table-padding;
        padding-right: root.table-padding;
        Text { text: "UTC"; width: root.utc-column-width; font-weight: 600; }
        Text { text: "Callsign"; width: root.callsign-column-width; font-weight: 600; }
        Text { text: "Mode"; width: root.mode-column-width; font-weight: 600; }
        Text { text: "Frequency"; width: root.frequency-column-width; font-weight: 600; }
        Text { text: "Band"; width: root.band-column-width; font-weight: 600; }
        Text { text: "Route / signal"; horizontal-stretch: 1; font-weight: 600; }
        Text { text: "Grid"; width: root.grid-column-width; font-weight: 600; }
        Text { text: "Actions"; min-width: 120px; font-weight: 600; horizontal-alignment: right; }
    }

    if root.qsos.length == 0 : EmptyState {
        vertical-stretch: 1;
        title: "No QSOs found";
        detail: root.search-text == "" && !root.filters-applied
            ? "Create a new QSO to start the logbook."
            : "Change the search or filters and try again.";
    }

    if root.qsos.length > 0 : ListView {
        vertical-stretch: 1;
        for qso[index] in root.qsos : Rectangle {
            height: row.preferred-height + 1px;
            Rectangle { height: 1px; width: parent.width; background: Palette.background.darker(0.12); }
            row := HorizontalBox {
                y: 1px;
                width: parent.width;
                padding-left: root.table-padding;
                padding-right: root.table-padding;
                padding-top: StyleMetrics.layout-spacing / 2;
                padding-bottom: StyleMetrics.layout-spacing / 2;

                Text { text: qso.timestamp; width: root.utc-column-width; vertical-alignment: center; overflow: elide; }
                TextAction {
                    width: root.callsign-column-width;
                    text: qso.callsign;
                    description: "Open external callsign lookup for " + qso.callsign;
                    activated => { root.open-callsign-lookup(qso.callsign); }
                }
                Text { text: qso.mode; width: root.mode-column-width; font-weight: 600; vertical-alignment: center; overflow: elide; }
                Text { text: qso.frequency; width: root.frequency-column-width; vertical-alignment: center; overflow: elide; }
                Text { text: qso.band == "" ? "—" : qso.band; width: root.band-column-width; vertical-alignment: center; overflow: elide; }
                Text {
                    text: qso.route-summary == "" ? "Direct" : qso.route-summary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    opacity: 0.8;
                }
                if qso.grid == "" : Text { text: "—"; width: root.grid-column-width; vertical-alignment: center; }
                if qso.grid != "" : TextAction {
                    width: root.grid-column-width;
                    text: qso.grid;
                    description: "Open external grid lookup for " + qso.grid;
                    activated => { root.open-grid-lookup(qso.grid); }
                }
                HorizontalBox {
                    min-width: 120px;
                    alignment: end;
                    Button {
                        text: "Edit";
                        clicked => {
                            root.editing-id = qso.id;
                            root.callsign-text = qso.callsign;
                            root.datetime-text = qso.datetime-input;
                            root.mode-text = qso.mode;
                            root.mode-input-changed(qso.mode);
                            root.frequency-text = qso.frequency-input;
                            root.band-text = qso.band;
                            root.rst-sent-text = qso.rst-sent;
                            root.rst-received-text = qso.rst-received;
                            root.grid-text = qso.grid;
                            root.name-text = qso.name;
                            root.qth-text = qso.qth;
                            root.notes-text = qso.notes;
                            root.dmr-remote-id-text = qso.dmr-remote-id;
                            root.dmr-local-id-text = qso.dmr-local-id;
                            root.dmr-talkgroup-text = qso.dmr-talkgroup;
                            root.dmr-timeslot-text = qso.dmr-timeslot;
                            root.dmr-color-code-text = qso.dmr-color-code;
                            root.dmr-network-text = qso.dmr-network;
                            root.dmr-call-type-text = qso.dmr-call-type == "" ? "group" : qso.dmr-call-type;
                            root.dmr-access-type-text = qso.dmr-access-type == "" ? "simplex" : qso.dmr-access-type;
                            root.dmr-repeater-text = qso.dmr-repeater;
                            root.dmr-hotspot-text = qso.dmr-hotspot;
                            root.dmr-notes-text = qso.dmr-notes;
                            root.ft8-snr-sent-text = qso.ft8-snr-sent;
                            root.ft8-snr-received-text = qso.ft8-snr-received;
                            root.ft8-power-text = qso.ft8-power;
                            root.ft8-audio-frequency-text = qso.ft8-audio-frequency;
                            root.ft8-source-software-text = qso.ft8-source-software;
                            root.ft8-protocol-text = qso.ft8-protocol == "" ? "FT8" : qso.ft8-protocol;
                            root.ft8-final-message-text = qso.ft8-final-message;
                            root.dstar-reflector-text = qso.dstar-reflector;
                            root.dstar-module-text = qso.dstar-module;
                            root.dstar-mycall-text = qso.dstar-mycall;
                            root.dstar-urcall-text = qso.dstar-urcall;
                            root.dstar-rpt1-text = qso.dstar-rpt1;
                            root.dstar-rpt2-text = qso.dstar-rpt2;
                            root.dstar-notes-text = qso.dstar-notes;
                            root.ysf-room-text = qso.ysf-room;
                            root.ysf-wires-x-node-text = qso.ysf-wires-x-node;
                            root.ysf-repeater-text = qso.ysf-repeater;
                            root.ysf-network-text = qso.ysf-network;
                            root.ysf-access-type-text = qso.ysf-access-type == "" ? "simplex" : qso.ysf-access-type;
                            root.ysf-tx-dg-id-text = qso.ysf-tx-dg-id;
                            root.ysf-rx-dg-id-text = qso.ysf-rx-dg-id;
                            root.ysf-notes-text = qso.ysf-notes;
                            root.active-page = 1;
                            root.editor-opened();
                        }
                    }
                    Button {
                        text: "Delete";
                        clicked => {
                            root.pending-delete-id = qso.id;
                            root.pending-delete-label = qso.callsign;
                        }
                    }
                }
            }
        }
    }

    HorizontalBox {
        Text {
            text: root.logbook-page-total == 0
                ? "0 QSOs"
                : (root.logbook-page-offset + 1) + "–"
                    + Math.min(root.logbook-page-offset + root.qsos.length, root.logbook-page-total)
                    + " of " + root.logbook-page-total;
            horizontal-stretch: 1;
        }
        Text { text: "Page " + root.logbook-page-number + " of " + root.logbook-page-count; vertical-alignment: center; opacity: 0.7; }
        Button { text: "Previous"; enabled: root.logbook-page-offset > 0; clicked => { root.previous-logbook-page(); } }
        Button {
            text: "Next";
            enabled: root.logbook-page-total > 0 && root.logbook-page-offset + root.logbook-page-limit < root.logbook-page-total;
            clicked => { root.next-logbook-page(); }
        }
    }

    if root.pending-delete-id != "" : GroupBox {
        title: "Delete QSO?";
        vertical-stretch: 0;
        HorizontalBox {
            Text {
                text: "Delete " + root.pending-delete-label + " permanently? This also removes its mode metadata.";
                horizontal-stretch: 1;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Button {
                text: "Cancel";
                clicked => {
                    root.pending-delete-id = "";
                    root.pending-delete-label = "";
                }
            }
            Button {
                text: "Delete";
                primary: true;
                clicked => {
                    root.delete-qso(root.pending-delete-id);
                    root.pending-delete-id = "";
                    root.pending-delete-label = "";
                }
            }
        }
    }
}
