import { Button, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, DataLabel, EmptyState, FilterChip, KeyboardAction, ModeBadge, SearchField, TechnicalValue } from "../design-system.slint";
import { QsoRow } from "../models/qso-types.slint";

export component LogbookPage inherits VerticalBox {
    accessible-role: main;
    accessible-label: "Logbook";
    in-out property <int> active-filter;
    in-out property <int> active-page;
    in-out property <string> band-text;
    in-out property <string> callsign-text;
    in-out property <string> datetime-text;
    in-out property <string> dmr-access-type-text;
    in-out property <string> dmr-call-type-text;
    in-out property <string> dmr-color-code-text;
    in-out property <string> dmr-filter-hotspot-text;
    in-out property <string> dmr-filter-id-text;
    in-out property <string> dmr-filter-network-text;
    in-out property <string> dmr-filter-repeater-text;
    in-out property <string> dmr-filter-talkgroup-text;
    in-out property <string> dmr-filter-timeslot-text;
    in-out property <string> dmr-hotspot-text;
    in-out property <string> dmr-local-id-text;
    in-out property <string> dmr-network-text;
    in-out property <string> dmr-notes-text;
    in-out property <string> dmr-remote-id-text;
    in-out property <string> dmr-repeater-text;
    in-out property <string> dmr-talkgroup-text;
    in-out property <string> dmr-timeslot-text;
    in-out property <string> editing-id;
    in-out property <bool> filters-applied;
    in-out property <bool> filters-expanded;
    in-out property <string> frequency-text;
    in-out property <string> ft8-audio-frequency-text;
    in-out property <string> ft8-filter-band-text;
    in-out property <string> ft8-filter-callsign-text;
    in-out property <string> ft8-filter-end-text;
    in-out property <string> ft8-filter-grid-text;
    in-out property <string> ft8-filter-max-snr-text;
    in-out property <string> ft8-filter-min-snr-text;
    in-out property <string> ft8-filter-start-text;
    in-out property <string> ft8-final-message-text;
    in-out property <string> ft8-power-text;
    in-out property <string> ft8-protocol-text;
    in-out property <string> ft8-snr-received-text;
    in-out property <string> ft8-snr-sent-text;
    in-out property <string> ft8-source-software-text;
    in-out property <string> dstar-reflector-text;
    in-out property <string> dstar-module-text;
    in-out property <string> dstar-mycall-text;
    in-out property <string> dstar-urcall-text;
    in-out property <string> dstar-rpt1-text;
    in-out property <string> dstar-rpt2-text;
    in-out property <string> dstar-notes-text;
    in-out property <string> dstar-filter-reflector-text;
    in-out property <string> dstar-filter-module-text;
    in-out property <string> dstar-filter-rpt1-text;
    in-out property <string> grid-text;
    in-out property <string> mode-text;
    in-out property <string> name-text;
    in-out property <string> notes-text;
    in-out property <string> pending-delete-id;
    in-out property <string> pending-delete-label;
    in-out property <[QsoRow]> qsos;
    in-out property <int> logbook-page-offset;
    in-out property <int> logbook-page-limit;
    in-out property <int> logbook-page-total;
    in-out property <int> logbook-page-number;
    in-out property <int> logbook-page-count;
    in-out property <string> qth-text;
    in-out property <string> rst-received-text;
    in-out property <string> rst-sent-text;
    in-out property <string> search-text;
    callback clear-dmr-filter();
    callback clear-ft8-filter();
    callback clear-dstar-filter();
    callback delete-qso(string);
    callback editor-opened();
    callback filter-dmr();
    callback filter-ft8();
    callback filter-dstar();
    callback mode-input-changed(string);
    callback previous-logbook-page();
    callback next-logbook-page();
    callback open-callsign-lookup(string);
    callback open-grid-lookup(string);
    callback request-page(int);
    callback search-qso(string);

            padding: Theme.space-md; spacing: Theme.space-sm;

            HorizontalBox {
                spacing: Theme.space-md;
                VerticalBox {
                    spacing: Theme.space-2xs;
                    Text { text: "QSO ACTIVITY"; color: Theme.text-primary; font-size: Theme.text-lg; font-weight: 700; }
                    Text {
                        text: root.logbook-page-total == 1 ? "1 contact in local log" : root.logbook-page-total + " contacts in local log";
                        color: Theme.text-muted; font-size: Theme.text-xs;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "LOCAL / UTC"; color: Theme.text-muted; font-size: Theme.text-xs; font-weight: 700; vertical-alignment: center; }
            }

            HorizontalBox {
                accessible-role: search;
                accessible-label: "Search and logbook actions";
                spacing: Theme.space-sm;
                SearchField {
                    text <=> root.search-text;
                    placeholder-text: "Search callsign or mode";
                    horizontal-stretch: 1;
                    accepted => { root.active-filter = 0; root.filters-applied = false; root.search-qso(root.search-text); }
                }
                KeyboardAction {
                    width: 76px; label: "Search"; description: "Search the logbook"; primary: true;
                    activated => { root.active-filter = 0; root.filters-applied = false; root.search-qso(root.search-text); }
                }
                KeyboardAction {
                    width: 68px; label: "Clear"; description: "Clear the current search"; enabled: root.search-text != "";
                    activated => { root.search-text = ""; root.active-filter = 0; root.filters-applied = false; root.search-qso(""); }
                }
                KeyboardAction {
                    width: 92px;
                    label: root.filters-expanded ? "Close filters" : root.filters-applied ? "Filters · ON" : "Filters";
                    description: root.filters-expanded ? "Close advanced filters" : "Open advanced filters";
                    active: root.filters-expanded || root.filters-applied;
                    activated => { root.filters-expanded = !root.filters-expanded; }
                }
            }

            if root.filters-applied : HorizontalBox {
                spacing: Theme.space-sm;
                FilterChip { text: root.active-filter == 1 ? "DMR FILTER" : root.active-filter == 2 ? "FT8 FILTER" : "D-STAR FILTER"; selected: true; }
                Text { text: "Filtered view"; color: Theme.text-muted; font-size: Theme.text-xs; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                KeyboardAction {
                    width: 86px; compact: true; label: "Clear filter"; description: "Clear active mode filter";
                    activated => {
                        if root.active-filter == 1 { root.clear-dmr-filter(); }
                        else if root.active-filter == 2 { root.clear-ft8-filter(); }
                        else if root.active-filter == 3 { root.clear-dstar-filter(); }
                    }
                }
            }

            if root.filters-expanded : Rectangle {
                accessible-role: search;
                accessible-label: "Advanced QSO filters";
                background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                VerticalBox {
                    padding: 12px; spacing: 10px;
                    HorizontalBox {
                        spacing: Theme.space-sm;
                        VerticalBox {
                            spacing: Theme.space-2xs;
                            Text { text: "ADVANCED FILTER"; color: Theme.text-primary; font-size: Theme.text-sm; font-weight: 700; }
                            Text { text: "Select a digital mode, then refine its technical fields."; color: Theme.text-muted; font-size: Theme.text-xs; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        KeyboardAction { width: 58px; compact: true; label: "All"; description: "Show all QSOs"; active: root.active-filter == 0; activated => { root.active-filter = 0; root.filters-applied = false; root.search-qso(root.search-text); } }
                        KeyboardAction { width: 58px; compact: true; label: "DMR"; description: "Configure DMR filters"; active: root.active-filter == 1; activated => { root.active-filter = 1; } }
                        KeyboardAction { width: 58px; compact: true; label: "FT8"; description: "Configure FT8 filters"; active: root.active-filter == 2; activated => { root.active-filter = 2; } }
                        KeyboardAction { width: 72px; compact: true; label: "D-STAR"; description: "Configure D-STAR filters"; active: root.active-filter == 3; activated => { root.active-filter = 3; } }
                    }

                    if root.active-filter == 0 : Text {
                        text: "Choose DMR, FT8, or D-STAR to configure mode-specific filters.";
                        color: Theme.text-secondary; vertical-alignment: center;
                    }

                    if root.active-filter == 1 : VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.dmr-filter-id-text; placeholder-text: "DMR ID"; }
                            LineEdit { text <=> root.dmr-filter-talkgroup-text; placeholder-text: "Talkgroup"; }
                            LineEdit { text <=> root.dmr-filter-network-text; placeholder-text: "Network"; }
                            LineEdit { text <=> root.dmr-filter-timeslot-text; placeholder-text: "Timeslot"; }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.dmr-filter-repeater-text; placeholder-text: "Repeater callsign"; horizontal-stretch: 1; }
                            LineEdit { text <=> root.dmr-filter-hotspot-text; placeholder-text: "Hotspot"; horizontal-stretch: 1; }
                            KeyboardAction { width: 60px; compact: true; label: "Clear"; description: "Clear DMR filter fields"; activated => { root.clear-dmr-filter(); } }
                            KeyboardAction { width: 96px; compact: true; primary: true; label: "Apply filter"; description: "Apply DMR filters"; activated => { root.filter-dmr(); } }
                        }
                    }

                    if root.active-filter == 3 : HorizontalBox {
                        spacing: 6px;
                        LineEdit { text <=> root.dstar-filter-reflector-text; placeholder-text: "Reflector"; horizontal-stretch: 1; }
                        LineEdit { text <=> root.dstar-filter-module-text; placeholder-text: "Module"; }
                        LineEdit { text <=> root.dstar-filter-rpt1-text; placeholder-text: "RPT1"; horizontal-stretch: 1; }
                        KeyboardAction { width: 60px; compact: true; label: "Clear"; description: "Clear D-STAR filter fields"; activated => { root.clear-dstar-filter(); } }
                        KeyboardAction { width: 96px; compact: true; primary: true; label: "Apply filter"; description: "Apply D-STAR filters"; activated => { root.filter-dstar(); } }
                    }

                    if root.active-filter == 2 : VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.ft8-filter-callsign-text; placeholder-text: "Callsign"; }
                            LineEdit { text <=> root.ft8-filter-grid-text; placeholder-text: "Grid"; }
                            LineEdit { text <=> root.ft8-filter-band-text; placeholder-text: "Band"; }
                            LineEdit { text <=> root.ft8-filter-min-snr-text; placeholder-text: "Min SNR"; }
                            LineEdit { text <=> root.ft8-filter-max-snr-text; placeholder-text: "Max SNR"; }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.ft8-filter-start-text; placeholder-text: "Start: YYYY-MM-DD HH:MM:SS UTC"; }
                            LineEdit { text <=> root.ft8-filter-end-text; placeholder-text: "End: YYYY-MM-DD HH:MM:SS UTC"; }
                            KeyboardAction { width: 60px; compact: true; label: "Clear"; description: "Clear FT8 filter fields"; activated => { root.clear-ft8-filter(); } }
                            KeyboardAction { width: 96px; compact: true; primary: true; label: "Apply filter"; description: "Apply FT8 filters"; activated => { root.filter-ft8(); } }
                        }
                    }
                }
            }

            Rectangle {
                height: 25px; background: Theme.background;
                HorizontalBox {
                    padding-left: Theme.space-md; padding-right: Theme.space-md; spacing: Theme.space-sm;
                    DataLabel { text: "UTC / STATION / MODE"; min-width: 344px; }
                    DataLabel { text: "RF"; min-width: 150px; }
                    DataLabel { text: "DIGITAL PATH / SIGNAL CONTEXT"; horizontal-stretch: 1; }
                    DataLabel { text: "ACTIONS"; min-width: 108px; horizontal-alignment: right; }
                }
            }

            if root.qsos.length == 0 : EmptyState {
                vertical-stretch: 1;
                title: "No QSOs found";
                detail: root.search-text == "" && !root.filters-applied
                    ? "Create a new QSO to start your logbook."
                    : "Try changing the current search or filters.";
            }

            if root.qsos.length > 0 : ListView {
                vertical-stretch: 1;
                for qso[index] in root.qsos : Rectangle {
                    height: 64px;
                    background: Math.mod(index, 2) == 0 ? Theme.surface : Theme.background;
                    border-width: 1px; border-color: Theme.border-subtle; border-radius: Theme.radius-xs;
                    VerticalBox {
                        padding-left: Theme.space-md; padding-right: Theme.space-md;
                        padding-top: Theme.space-xs; padding-bottom: Theme.space-xs;
                        spacing: Theme.space-2xs;
                        HorizontalBox {
                            height: 25px;
                            vertical-stretch: 0;
                            spacing: Theme.space-sm;
                            Text { text: qso.timestamp; color: Theme.text-secondary; width: 150px; font-size: Theme.text-sm; vertical-alignment: center; overflow: elide; }
                            KeyboardAction {
                                width: 126px;
                                label: qso.callsign;
                                description: "Open external callsign lookup for " + qso.callsign;
                                link: true;
                                compact: true;
                                activated => { root.open-callsign-lookup(qso.callsign); }
                            }
                            ModeBadge { mode: qso.mode; }
                            TechnicalValue { text: qso.frequency; width: 116px; }
                            Text { text: qso.band == "" ? "—" : qso.band; color: Theme.text-secondary; width: 48px; font-size: Theme.text-xs; font-weight: 700; vertical-alignment: center; overflow: elide; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalBox {
                            height: 27px;
                            vertical-stretch: 0;
                            spacing: Theme.space-sm;
                            Text { text: "PATH"; color: Theme.text-muted; width: 38px; font-size: Theme.text-xs; font-weight: 700; vertical-alignment: center; }
                            Text { text: qso.route-summary == "" ? "Direct / no additional route data" : qso.route-summary; color: Theme.text-muted; min-width: 250px; horizontal-stretch: 1; font-size: Theme.text-xs; vertical-alignment: center; overflow: elide; }
                            if qso.grid == "" : Text { text: "GRID  —"; color: Theme.text-disabled; width: 82px; font-size: Theme.text-xs; vertical-alignment: center; }
                            if qso.grid != "" : KeyboardAction {
                                width: 82px;
                                label: "GRID  " + qso.grid;
                                description: "Open external grid lookup for " + qso.grid;
                                link: true;
                                compact: true;
                                activated => { root.open-grid-lookup(qso.grid); }
                            }
                            KeyboardAction {
                                width: 48px; compact: true; label: "Edit"; description: "Edit QSO with " + qso.callsign;
                                activated => {
                                    root.editing-id = qso.id; root.callsign-text = qso.callsign;
                                    root.datetime-text = qso.datetime-input; root.mode-text = qso.mode;
                                    root.mode-input-changed(qso.mode); root.frequency-text = qso.frequency-input; root.band-text = qso.band;
                                    root.rst-sent-text = qso.rst-sent; root.rst-received-text = qso.rst-received;
                                    root.grid-text = qso.grid; root.name-text = qso.name; root.qth-text = qso.qth;
                                    root.notes-text = qso.notes; root.dmr-remote-id-text = qso.dmr-remote-id;
                                    root.dmr-local-id-text = qso.dmr-local-id; root.dmr-talkgroup-text = qso.dmr-talkgroup;
                                    root.dmr-timeslot-text = qso.dmr-timeslot; root.dmr-color-code-text = qso.dmr-color-code;
                                    root.dmr-network-text = qso.dmr-network;
                                    root.dmr-call-type-text = qso.dmr-call-type == "" ? "group" : qso.dmr-call-type;
                                    root.dmr-access-type-text = qso.dmr-access-type == "" ? "simplex" : qso.dmr-access-type;
                                    root.dmr-repeater-text = qso.dmr-repeater; root.dmr-hotspot-text = qso.dmr-hotspot;
                                    root.dmr-notes-text = qso.dmr-notes; root.ft8-snr-sent-text = qso.ft8-snr-sent;
                                    root.ft8-snr-received-text = qso.ft8-snr-received; root.ft8-power-text = qso.ft8-power;
                                    root.ft8-audio-frequency-text = qso.ft8-audio-frequency;
                                    root.ft8-source-software-text = qso.ft8-source-software;
                                    root.ft8-protocol-text = qso.ft8-protocol == "" ? "FT8" : qso.ft8-protocol;
                                    root.ft8-final-message-text = qso.ft8-final-message;
                                    root.dstar-reflector-text = qso.dstar-reflector; root.dstar-module-text = qso.dstar-module;
                                    root.dstar-mycall-text = qso.dstar-mycall; root.dstar-urcall-text = qso.dstar-urcall;
                                    root.dstar-rpt1-text = qso.dstar-rpt1; root.dstar-rpt2-text = qso.dstar-rpt2;
                                    root.dstar-notes-text = qso.dstar-notes; root.active-page = 1; root.editor-opened();
                                }
                            }
                            KeyboardAction {
                                width: 54px; compact: true; label: "Delete"; description: "Delete QSO with " + qso.callsign;
                                activated => { root.pending-delete-id = qso.id; root.pending-delete-label = qso.callsign; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 35px; background: Theme.surface; border-width: 1px; border-color: Theme.border-subtle; border-radius: Theme.radius-sm;
                HorizontalBox {
                    padding-left: Theme.space-md; padding-right: Theme.space-xs; padding-top: Theme.space-xs; padding-bottom: Theme.space-xs; spacing: Theme.space-sm;
                    Text {
                        text: root.logbook-page-total == 0
                            ? "0 QSOs"
                            : (root.logbook-page-offset + 1) + "–" + Math.min(root.logbook-page-offset + root.qsos.length, root.logbook-page-total) + " / " + root.logbook-page-total + " QSOs";
                        color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1;
                    }
                    Text {
                        text: "PAGE " + root.logbook-page-number + " OF " + root.logbook-page-count;
                        color: Theme.text-muted; font-size: Theme.text-xs; font-weight: 700; vertical-alignment: center;
                    }
                    KeyboardAction { width: 72px; compact: true; label: "Previous"; description: "Open previous logbook page"; enabled: root.logbook-page-offset > 0; activated => { root.previous-logbook-page(); } }
                    KeyboardAction {
                        width: 54px; compact: true; label: "Next"; description: "Open next logbook page";
                        enabled: root.logbook-page-total > 0 && root.logbook-page-offset + root.logbook-page-limit < root.logbook-page-total;
                        activated => { root.next-logbook-page(); }
                    }
                }
            }

            if root.pending-delete-id != "" : Rectangle {
                background: Theme.danger-surface; border-width: 1px; border-color: Theme.danger; border-radius: Theme.radius-sm;
                HorizontalBox {
                    padding: Theme.space-md; spacing: Theme.space-md;
                    Rectangle { width: 3px; background: Theme.danger; }
                    VerticalBox {
                        spacing: Theme.space-2xs; horizontal-stretch: 1;
                        Text { text: "DELETE QSO  /  " + root.pending-delete-label; color: Theme.danger; font-size: Theme.text-sm; font-weight: 700; }
                        Text { text: "Permanent action. The contact and its mode metadata will be removed."; color: Theme.text-secondary; font-size: Theme.text-xs; }
                    }
                    KeyboardAction { width: 66px; compact: true; label: "Cancel"; description: "Cancel QSO deletion"; activated => { root.pending-delete-id = ""; root.pending-delete-label = ""; } }
                    KeyboardAction { width: 104px; compact: true; danger: true; label: "Confirm delete"; description: "Permanently delete QSO with " + root.pending-delete-label; activated => { root.delete-qso(root.pending-delete-id); root.pending-delete-id = ""; root.pending-delete-label = ""; } }
                }
            }
        }
