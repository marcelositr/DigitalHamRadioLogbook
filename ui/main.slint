import { Button, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, EmptyState, ModeBadge, PageTitle, SectionTitle, StationBadge, StatusBar } from "design-system.slint";

import { QsoRow } from "models/qso-types.slint";
import { LogbookPage } from "pages/logbook-page.slint";
import { QsoEditorPage } from "pages/qso-editor-page.slint";
import { ToolsPage } from "pages/tools-page.slint";
import { SettingsPage } from "pages/settings-page.slint";

export component MainWindow inherits Window {
    title: "Digital Ham Radio Logbook";
    width: 1050px;
    height: 680px;
    background: Theme.background;

    in-out property <int> active-page: 0; // 0 logbook, 1 form, 2 tools, 3 settings
    in-out property <int> active-filter: 0; // 0 all, 1 DMR, 2 FT8
    in-out property <bool> filters-expanded: false;
    in-out property <bool> filters-applied: false;
    in-out property <[QsoRow]> qsos;
    in-out property <int> logbook-page-offset;
    in-out property <int> logbook-page-limit;
    in-out property <int> logbook-page-total;
    in-out property <int> logbook-page-number;
    in-out property <int> logbook-page-count;
    in-out property <string> status-text: "Ready";
    in-out property <int> status-kind: 0; // 0 info, 1 success, 2 warning, 3 error
    in-out property <string> local-callsign-text;
    in-out property <string> callsign-url-text;
    in-out property <string> grid-url-text;
    in-out property <string> editing-id;
    in-out property <string> callsign-text;
    in-out property <string> datetime-text;
    in-out property <string> mode-text;
    in-out property <int> mode-kind: 0; // 0 generic, 1 DMR, 2 FT8
    in-out property <string> frequency-text;
    in-out property <string> band-text;
    in-out property <string> rst-sent-text;
    in-out property <string> rst-received-text;
    in-out property <string> grid-text;
    in-out property <string> name-text;
    in-out property <string> qth-text;
    in-out property <string> notes-text;
    in-out property <string> dmr-remote-id-text;
    in-out property <string> dmr-local-id-text;
    in-out property <string> dmr-talkgroup-text;
    in-out property <string> dmr-timeslot-text;
    in-out property <string> dmr-color-code-text;
    in-out property <string> dmr-network-text;
    in-out property <string> dmr-call-type-text: "group";
    in-out property <string> dmr-access-type-text: "simplex";
    in-out property <string> dmr-repeater-text;
    in-out property <string> dmr-hotspot-text;
    in-out property <string> dmr-notes-text;
    in-out property <string> ft8-snr-sent-text;
    in-out property <string> ft8-snr-received-text;
    in-out property <string> ft8-power-text;
    in-out property <string> ft8-audio-frequency-text;
    in-out property <string> ft8-source-software-text;
    in-out property <string> ft8-protocol-text: "FT8";
    in-out property <string> ft8-final-message-text;
    in-out property <string> search-text;
    in-out property <string> dmr-filter-id-text;
    in-out property <string> dmr-filter-talkgroup-text;
    in-out property <string> dmr-filter-network-text;
    in-out property <string> dmr-filter-repeater-text;
    in-out property <string> dmr-filter-hotspot-text;
    in-out property <string> dmr-filter-timeslot-text;
    in-out property <string> ft8-filter-callsign-text;
    in-out property <string> ft8-filter-grid-text;
    in-out property <string> ft8-filter-band-text;
    in-out property <string> ft8-filter-min-snr-text;
    in-out property <string> ft8-filter-max-snr-text;
    in-out property <string> ft8-filter-start-text;
    in-out property <string> ft8-filter-end-text;
    in-out property <string> adif-path-text;
    in-out property <string> backup-path-text;
    in-out property <string> pending-delete-id;
    in-out property <string> pending-delete-label;
    in-out property <bool> adif-preview-visible: false;
    in-out property <int> adif-preview-total;
    in-out property <int> adif-preview-new;
    in-out property <int> adif-preview-duplicates;
    in-out property <int> adif-preview-invalid;
    in-out property <string> adif-preview-modes;
    in-out property <string> adif-preview-bands;
    in-out property <string> adif-preview-date-range;
    in-out property <string> adif-preview-invalid-details;
    in-out property <bool> discard-editor-visible: false;
    in-out property <int> pending-page: 0;
    in-out property <bool> exit-confirmation-visible: false;
    in-out property <bool> exit-save-failed: false;
    in-out property <string> exit-error-text;

    callback save-qso(); callback search-qso(string); callback mode-input-changed(string);
    callback previous-logbook-page(); callback next-logbook-page();
    callback filter-dmr(); callback clear-dmr-filter();
    callback filter-ft8(); callback clear-ft8-filter();
    callback save-local-callsign(); callback save-external-links(); callback restore-external-link-defaults();
    callback open-callsign-lookup(string); callback open-grid-lookup(string);
    callback preview-adif(); callback confirm-adif-import(); callback cancel-adif-import(); callback invalidate-adif-preview(); callback export-adif();
    callback choose-adif-import(); callback choose-adif-export(); callback choose-backup-destination();
    callback backup-database(); callback delete-qso(string); callback clear-editor();
    callback request-page(int); callback confirm-discard-editor(); callback keep-editing(); callback editor-opened();
    callback continue-working(); callback discard-and-exit(); callback retry-exit(); callback exit-without-saving();

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.pending-delete-id = "";
                root.pending-delete-label = "";
                if root.adif-preview-visible { root.cancel-adif-import(); }
                if root.exit-confirmation-visible { root.continue-working(); }
                else if root.discard-editor-visible { root.keep-editing(); }
                else if root.active-page == 1 { root.request-page(0); }
                return accept;
            }
            return reject;
        }
    }

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 72px;
            background: Theme.background;
            HorizontalBox {
                padding-left: Theme.space-lg; padding-right: Theme.space-lg;
                padding-top: Theme.space-sm; padding-bottom: Theme.space-sm;
                spacing: Theme.space-md;
                VerticalBox {
                    spacing: Theme.space-xs; horizontal-stretch: 1; alignment: center;
                    Text { text: "Digital Ham Radio Logbook"; color: Theme.text-primary; font-size: 21px; font-weight: 700; }
                    Text { text: "Local, offline digital contact logging"; color: Theme.text-muted; font-size: 12px; }
                }
                StationBadge { callsign: root.local-callsign-text; }
            }
        }

        Rectangle {
            height: 48px;
            background: Theme.surface;
            HorizontalBox {
                padding-left: Theme.space-md; padding-right: Theme.space-md; padding-top: 6px; padding-bottom: 6px; spacing: Theme.space-sm;
                Rectangle {
                    width: 100px; border-radius: 4px;
                    background: root.active-page == 0 ? Theme.primary : logbook-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "Logbook"; color: Theme.text-primary; font-weight: root.active-page == 0 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    logbook-touch := TouchArea { clicked => { root.request-page(0); } }
                }
                Rectangle {
                    width: 112px; border-radius: 4px;
                    background: root.active-page == 1 ? Theme.primary : new-qso-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "New QSO"; color: Theme.text-primary; font-weight: root.active-page == 1 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    new-qso-touch := TouchArea { clicked => { root.request-page(1); } }
                }
                Rectangle {
                    width: 92px; border-radius: 4px;
                    background: root.active-page == 2 ? Theme.primary : tools-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "Tools"; color: Theme.text-primary; font-weight: root.active-page == 2 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    tools-touch := TouchArea { clicked => { root.request-page(2); } }
                }
                Rectangle {
                    width: 104px; border-radius: 4px;
                    background: root.active-page == 3 ? Theme.primary : settings-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "Settings"; color: Theme.text-primary; font-weight: root.active-page == 3 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    settings-touch := TouchArea { clicked => { root.request-page(3); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        if root.exit-confirmation-visible : Rectangle {
            background: Theme.surface-raised; border-width: 1px; border-color: root.exit-save-failed ? Theme.danger : Theme.warning; border-radius: Theme.radius-md;
            HorizontalBox {
                padding: Theme.space-md; spacing: Theme.space-md;
                VerticalBox {
                    spacing: 2px; horizontal-stretch: 1;
                    Text { text: root.exit-save-failed ? "Could not save preferences" : "Exit with pending work?"; color: root.exit-save-failed ? Theme.danger : Theme.warning; font-weight: 700; }
                    Text { text: root.exit-save-failed ? root.exit-error-text : "Unsaved QSO changes or an ADIF preview will be discarded."; color: Theme.text-secondary; wrap: word-wrap; }
                }
                Button { text: "Continue working"; clicked => { root.continue-working(); } }
                if root.exit-save-failed : Button { text: "Exit without saving preferences"; clicked => { root.exit-without-saving(); } }
                Button { text: root.exit-save-failed ? "Try again" : "Discard and exit"; primary: true; clicked => { if root.exit-save-failed { root.retry-exit(); } else { root.discard-and-exit(); } } }
            }
        }

        if root.active-page == 0 : LogbookPage {
            active-filter <=> root.active-filter;
            active-page <=> root.active-page;
            band-text <=> root.band-text;
            callsign-text <=> root.callsign-text;
            datetime-text <=> root.datetime-text;
            dmr-access-type-text <=> root.dmr-access-type-text;
            dmr-call-type-text <=> root.dmr-call-type-text;
            dmr-color-code-text <=> root.dmr-color-code-text;
            dmr-filter-hotspot-text <=> root.dmr-filter-hotspot-text;
            dmr-filter-id-text <=> root.dmr-filter-id-text;
            dmr-filter-network-text <=> root.dmr-filter-network-text;
            dmr-filter-repeater-text <=> root.dmr-filter-repeater-text;
            dmr-filter-talkgroup-text <=> root.dmr-filter-talkgroup-text;
            dmr-filter-timeslot-text <=> root.dmr-filter-timeslot-text;
            dmr-hotspot-text <=> root.dmr-hotspot-text;
            dmr-local-id-text <=> root.dmr-local-id-text;
            dmr-network-text <=> root.dmr-network-text;
            dmr-notes-text <=> root.dmr-notes-text;
            dmr-remote-id-text <=> root.dmr-remote-id-text;
            dmr-repeater-text <=> root.dmr-repeater-text;
            dmr-talkgroup-text <=> root.dmr-talkgroup-text;
            dmr-timeslot-text <=> root.dmr-timeslot-text;
            editing-id <=> root.editing-id;
            filters-applied <=> root.filters-applied;
            filters-expanded <=> root.filters-expanded;
            frequency-text <=> root.frequency-text;
            ft8-audio-frequency-text <=> root.ft8-audio-frequency-text;
            ft8-filter-band-text <=> root.ft8-filter-band-text;
            ft8-filter-callsign-text <=> root.ft8-filter-callsign-text;
            ft8-filter-end-text <=> root.ft8-filter-end-text;
            ft8-filter-grid-text <=> root.ft8-filter-grid-text;
            ft8-filter-max-snr-text <=> root.ft8-filter-max-snr-text;
            ft8-filter-min-snr-text <=> root.ft8-filter-min-snr-text;
            ft8-filter-start-text <=> root.ft8-filter-start-text;
            ft8-final-message-text <=> root.ft8-final-message-text;
            ft8-power-text <=> root.ft8-power-text;
            ft8-protocol-text <=> root.ft8-protocol-text;
            ft8-snr-received-text <=> root.ft8-snr-received-text;
            ft8-snr-sent-text <=> root.ft8-snr-sent-text;
            ft8-source-software-text <=> root.ft8-source-software-text;
            grid-text <=> root.grid-text;
            mode-text <=> root.mode-text;
            name-text <=> root.name-text;
            notes-text <=> root.notes-text;
            pending-delete-id <=> root.pending-delete-id;
            pending-delete-label <=> root.pending-delete-label;
            qsos <=> root.qsos;
            logbook-page-offset <=> root.logbook-page-offset;
            logbook-page-limit <=> root.logbook-page-limit;
            logbook-page-total <=> root.logbook-page-total;
            logbook-page-number <=> root.logbook-page-number;
            logbook-page-count <=> root.logbook-page-count;
            qth-text <=> root.qth-text;
            rst-received-text <=> root.rst-received-text;
            rst-sent-text <=> root.rst-sent-text;
            search-text <=> root.search-text;
            clear-dmr-filter => { root.clear-dmr-filter(); }
            clear-ft8-filter => { root.clear-ft8-filter(); }
            delete-qso(value) => { root.delete-qso(value); }
            editor-opened => { root.editor-opened(); }
            filter-dmr => { root.filter-dmr(); }
            filter-ft8 => { root.filter-ft8(); }
            mode-input-changed(value) => { root.mode-input-changed(value); }
            previous-logbook-page => { root.previous-logbook-page(); }
            next-logbook-page => { root.next-logbook-page(); }
            open-callsign-lookup(value) => { root.open-callsign-lookup(value); }
            open-grid-lookup(value) => { root.open-grid-lookup(value); }
            request-page(value) => { root.request-page(value); }
            search-qso(value) => { root.search-qso(value); }
        }

        if root.active-page == 1 : QsoEditorPage {
            band-text <=> root.band-text;
            callsign-text <=> root.callsign-text;
            datetime-text <=> root.datetime-text;
            discard-editor-visible <=> root.discard-editor-visible;
            dmr-access-type-text <=> root.dmr-access-type-text;
            dmr-call-type-text <=> root.dmr-call-type-text;
            dmr-color-code-text <=> root.dmr-color-code-text;
            dmr-hotspot-text <=> root.dmr-hotspot-text;
            dmr-local-id-text <=> root.dmr-local-id-text;
            dmr-network-text <=> root.dmr-network-text;
            dmr-notes-text <=> root.dmr-notes-text;
            dmr-remote-id-text <=> root.dmr-remote-id-text;
            dmr-repeater-text <=> root.dmr-repeater-text;
            dmr-talkgroup-text <=> root.dmr-talkgroup-text;
            dmr-timeslot-text <=> root.dmr-timeslot-text;
            editing-id <=> root.editing-id;
            frequency-text <=> root.frequency-text;
            ft8-audio-frequency-text <=> root.ft8-audio-frequency-text;
            ft8-final-message-text <=> root.ft8-final-message-text;
            ft8-power-text <=> root.ft8-power-text;
            ft8-protocol-text <=> root.ft8-protocol-text;
            ft8-snr-received-text <=> root.ft8-snr-received-text;
            ft8-snr-sent-text <=> root.ft8-snr-sent-text;
            ft8-source-software-text <=> root.ft8-source-software-text;
            grid-text <=> root.grid-text;
            mode-kind <=> root.mode-kind;
            mode-text <=> root.mode-text;
            name-text <=> root.name-text;
            notes-text <=> root.notes-text;
            qth-text <=> root.qth-text;
            rst-received-text <=> root.rst-received-text;
            rst-sent-text <=> root.rst-sent-text;
            confirm-discard-editor => { root.confirm-discard-editor(); }
            keep-editing => { root.keep-editing(); }
            mode-input-changed(value) => { root.mode-input-changed(value); }
            request-page(value) => { root.request-page(value); }
            save-qso => { root.save-qso(); }
        }

        if root.active-page == 2 : ToolsPage {
            adif-path-text <=> root.adif-path-text;
            adif-preview-duplicates <=> root.adif-preview-duplicates;
            adif-preview-invalid <=> root.adif-preview-invalid;
            adif-preview-modes <=> root.adif-preview-modes;
            adif-preview-bands <=> root.adif-preview-bands;
            adif-preview-date-range <=> root.adif-preview-date-range;
            adif-preview-invalid-details <=> root.adif-preview-invalid-details;
            adif-preview-new <=> root.adif-preview-new;
            adif-preview-total <=> root.adif-preview-total;
            adif-preview-visible <=> root.adif-preview-visible;
            backup-path-text <=> root.backup-path-text;
            backup-database => { root.backup-database(); }
            cancel-adif-import => { root.cancel-adif-import(); }
            choose-adif-export => { root.choose-adif-export(); }
            choose-adif-import => { root.choose-adif-import(); }
            choose-backup-destination => { root.choose-backup-destination(); }
            confirm-adif-import => { root.confirm-adif-import(); }
            export-adif => { root.export-adif(); }
            invalidate-adif-preview => { root.invalidate-adif-preview(); }
            preview-adif => { root.preview-adif(); }
        }

        if root.active-page == 3 : SettingsPage {
            callsign-url-text <=> root.callsign-url-text;
            grid-url-text <=> root.grid-url-text;
            local-callsign-text <=> root.local-callsign-text;
            restore-external-link-defaults => { root.restore-external-link-defaults(); }
            save-external-links => { root.save-external-links(); }
            save-local-callsign => { root.save-local-callsign(); }
        }

        StatusBar { message: root.status-text; kind: root.status-kind; }
    }
}
