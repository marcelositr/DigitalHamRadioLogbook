import { Button, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, EmptyState, ModeBadge, PageTitle, SectionTitle, StationBadge, StatusBar } from "design-system.slint";

export struct QsoRow {
    id: string, callsign: string, timestamp: string, datetime-input: string,
    frequency: string, frequency-input: string, band: string, mode: string,
    rst-sent: string, rst-received: string, grid: string, name: string, qth: string,
    notes: string, route-summary: string,
    dmr-remote-id: string, dmr-local-id: string, dmr-talkgroup: string,
    dmr-timeslot: string, dmr-color-code: string, dmr-network: string,
    dmr-call-type: string, dmr-access-type: string, dmr-repeater: string,
    dmr-hotspot: string, dmr-notes: string,
    ft8-snr-sent: string, ft8-snr-received: string, ft8-power: string,
    ft8-audio-frequency: string, ft8-source-software: string,
    ft8-protocol: string, ft8-final-message: string,
}

export component MainWindow inherits Window {
    title: "Digital Ham Radio Logbook";
    width: 1050px;
    height: 680px;
    background: Theme.background;

    in-out property <int> active-page: 0; // 0 logbook, 1 form, 2 tools, 3 settings
    in-out property <int> active-filter: 0; // 0 all, 1 DMR, 2 FT8
    in-out property <bool> filters-expanded: false;
    in-out property <bool> filters-applied: false;
    in-out property <[QsoRow]> qsos;
    in-out property <string> status-text: "Ready";
    in-out property <int> status-kind: 0; // 0 info, 1 success, 2 warning, 3 error
    in-out property <string> local-callsign-text;
    in-out property <string> callsign-url-text;
    in-out property <string> grid-url-text;
    in-out property <string> editing-id;
    in-out property <string> callsign-text;
    in-out property <string> datetime-text;
    in-out property <string> mode-text;
    in-out property <int> mode-kind: 0; // 0 generic, 1 DMR, 2 FT8
    in-out property <string> frequency-text;
    in-out property <string> band-text;
    in-out property <string> rst-sent-text;
    in-out property <string> rst-received-text;
    in-out property <string> grid-text;
    in-out property <string> name-text;
    in-out property <string> qth-text;
    in-out property <string> notes-text;
    in-out property <string> dmr-remote-id-text;
    in-out property <string> dmr-local-id-text;
    in-out property <string> dmr-talkgroup-text;
    in-out property <string> dmr-timeslot-text;
    in-out property <string> dmr-color-code-text;
    in-out property <string> dmr-network-text;
    in-out property <string> dmr-call-type-text: "group";
    in-out property <string> dmr-access-type-text: "simplex";
    in-out property <string> dmr-repeater-text;
    in-out property <string> dmr-hotspot-text;
    in-out property <string> dmr-notes-text;
    in-out property <string> ft8-snr-sent-text;
    in-out property <string> ft8-snr-received-text;
    in-out property <string> ft8-power-text;
    in-out property <string> ft8-audio-frequency-text;
    in-out property <string> ft8-source-software-text;
    in-out property <string> ft8-protocol-text: "FT8";
    in-out property <string> ft8-final-message-text;
    in-out property <string> search-text;
    in-out property <string> dmr-filter-id-text;
    in-out property <string> dmr-filter-talkgroup-text;
    in-out property <string> dmr-filter-network-text;
    in-out property <string> dmr-filter-repeater-text;
    in-out property <string> dmr-filter-hotspot-text;
    in-out property <string> dmr-filter-timeslot-text;
    in-out property <string> ft8-filter-callsign-text;
    in-out property <string> ft8-filter-grid-text;
    in-out property <string> ft8-filter-band-text;
    in-out property <string> ft8-filter-min-snr-text;
    in-out property <string> ft8-filter-max-snr-text;
    in-out property <string> ft8-filter-start-text;
    in-out property <string> ft8-filter-end-text;
    in-out property <string> adif-path-text;
    in-out property <string> backup-path-text;
    in-out property <string> pending-delete-id;
    in-out property <string> pending-delete-label;

    callback save-qso(); callback search-qso(string); callback mode-input-changed(string);
    callback filter-dmr(); callback clear-dmr-filter();
    callback filter-ft8(); callback clear-ft8-filter();
    callback save-local-callsign(); callback save-external-links(); callback restore-external-link-defaults();
    callback open-callsign-lookup(string); callback open-grid-lookup(string);
    callback import-adif(); callback export-adif();
    callback choose-adif-import(); callback choose-adif-export(); callback choose-backup-destination();
    callback backup-database(); callback delete-qso(string); callback clear-editor();

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.pending-delete-id = "";
                root.pending-delete-label = "";
                if root.active-page == 1 { root.clear-editor(); root.active-page = 0; }
                return accept;
            }
            return reject;
        }
    }

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 72px;
            background: Theme.background;
            HorizontalBox {
                padding-left: Theme.space-lg; padding-right: Theme.space-lg;
                padding-top: Theme.space-sm; padding-bottom: Theme.space-sm;
                spacing: Theme.space-md;
                VerticalBox {
                    spacing: Theme.space-xs; horizontal-stretch: 1; alignment: center;
                    Text { text: "Digital Ham Radio Logbook"; color: Theme.text-primary; font-size: 21px; font-weight: 700; }
                    Text { text: "Local, offline digital contact logging"; color: Theme.text-muted; font-size: 12px; }
                }
                StationBadge { callsign: root.local-callsign-text; }
            }
        }

        Rectangle {
            height: 48px;
            background: Theme.surface;
            HorizontalBox {
                padding-left: Theme.space-md; padding-right: Theme.space-md; padding-top: 6px; padding-bottom: 6px; spacing: Theme.space-sm;
                Rectangle {
                    width: 100px; border-radius: 4px;
                    background: root.active-page == 0 ? Theme.primary : logbook-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "Logbook"; color: Theme.text-primary; font-weight: root.active-page == 0 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    logbook-touch := TouchArea { clicked => { root.active-page = 0; } }
                }
                Rectangle {
                    width: 112px; border-radius: 4px;
                    background: root.active-page == 1 ? Theme.primary : new-qso-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "New QSO"; color: Theme.text-primary; font-weight: root.active-page == 1 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    new-qso-touch := TouchArea { clicked => { root.clear-editor(); root.active-page = 1; } }
                }
                Rectangle {
                    width: 92px; border-radius: 4px;
                    background: root.active-page == 2 ? Theme.primary : tools-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "Tools"; color: Theme.text-primary; font-weight: root.active-page == 2 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    tools-touch := TouchArea { clicked => { root.active-page = 2; } }
                }
                Rectangle {
                    width: 104px; border-radius: 4px;
                    background: root.active-page == 3 ? Theme.primary : settings-touch.has-hover ? Theme.border : Theme.surface;
                    Text { text: "Settings"; color: Theme.text-primary; font-weight: root.active-page == 3 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
                    settings-touch := TouchArea { clicked => { root.active-page = 3; } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // LOGBOOK
        if root.active-page == 0 : VerticalBox {
            padding: 12px; spacing: 8px;

            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    text <=> root.search-text; placeholder-text: "Search by callsign or mode";
                    horizontal-stretch: 1;
                    accepted => { root.active-filter = 0; root.filters-applied = false; root.search-qso(root.search-text); }
                }
                Button { text: "Search"; clicked => { root.active-filter = 0; root.filters-applied = false; root.search-qso(root.search-text); } }
                Button { text: "Clear search"; clicked => { root.search-text = ""; root.active-filter = 0; root.filters-applied = false; root.search-qso(""); } }
                Button {
                    text: root.filters-expanded ? "Close filters" : root.filters-applied ? "Filters active" : "Filters";
                    clicked => { root.filters-expanded = !root.filters-expanded; }
                }
                Button { text: "+ New QSO"; primary: true; clicked => { root.clear-editor(); root.active-page = 1; } }
            }

            if root.filters-applied : Rectangle {
                background: Theme.surface-raised; border-radius: Theme.radius-sm;
                HorizontalBox {
                    padding-left: 10px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
                    Text {
                        text: root.active-filter == 1 ? "DMR filters active" : "FT8 filters active";
                        color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1;
                    }
                    Button {
                        text: "Clear filters";
                        clicked => {
                            if root.active-filter == 1 { root.clear-dmr-filter(); }
                            else if root.active-filter == 2 { root.clear-ft8-filter(); }
                        }
                    }
                }
            }

            if root.filters-expanded : Rectangle {
                background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm;
                VerticalBox {
                    padding: 12px; spacing: 10px;
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Advanced filters"; color: Theme.text-primary; font-weight: 700; vertical-alignment: center; }
                        Button { text: "All"; enabled: root.active-filter != 0; clicked => { root.active-filter = 0; root.filters-applied = false; root.search-qso(root.search-text); } }
                        Button { text: "DMR"; enabled: root.active-filter != 1; clicked => { root.active-filter = 1; } }
                        Button { text: "FT8"; enabled: root.active-filter != 2; clicked => { root.active-filter = 2; } }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.active-filter == 0 : Text {
                        text: "Choose DMR or FT8 to configure mode-specific filters.";
                        color: Theme.text-secondary; vertical-alignment: center;
                    }

                    if root.active-filter == 1 : VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.dmr-filter-id-text; placeholder-text: "DMR ID"; }
                            LineEdit { text <=> root.dmr-filter-talkgroup-text; placeholder-text: "Talkgroup"; }
                            LineEdit { text <=> root.dmr-filter-network-text; placeholder-text: "Network"; }
                            LineEdit { text <=> root.dmr-filter-timeslot-text; placeholder-text: "Timeslot"; }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.dmr-filter-repeater-text; placeholder-text: "Repeater callsign"; horizontal-stretch: 1; }
                            LineEdit { text <=> root.dmr-filter-hotspot-text; placeholder-text: "Hotspot"; horizontal-stretch: 1; }
                            Button { text: "Clear"; clicked => { root.clear-dmr-filter(); } }
                            Button { text: "Apply filters"; primary: true; clicked => { root.filter-dmr(); } }
                        }
                    }

                    if root.active-filter == 2 : VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.ft8-filter-callsign-text; placeholder-text: "Callsign"; }
                            LineEdit { text <=> root.ft8-filter-grid-text; placeholder-text: "Grid"; }
                            LineEdit { text <=> root.ft8-filter-band-text; placeholder-text: "Band"; }
                            LineEdit { text <=> root.ft8-filter-min-snr-text; placeholder-text: "Min SNR"; }
                            LineEdit { text <=> root.ft8-filter-max-snr-text; placeholder-text: "Max SNR"; }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            LineEdit { text <=> root.ft8-filter-start-text; placeholder-text: "Start: YYYY-MM-DD HH:MM:SS UTC"; }
                            LineEdit { text <=> root.ft8-filter-end-text; placeholder-text: "End: YYYY-MM-DD HH:MM:SS UTC"; }
                            Button { text: "Clear"; clicked => { root.clear-ft8-filter(); } }
                            Button { text: "Apply filters"; primary: true; clicked => { root.filter-ft8(); } }
                        }
                    }
                }
            }

            Rectangle {
                height: 34px; background: Theme.surface-raised; border-radius: Theme.radius-sm;
                HorizontalBox {
                    padding-left: Theme.space-sm; padding-right: Theme.space-sm; spacing: Theme.space-xs;
                    Text { text: "UTC DATE/TIME"; color: Theme.text-secondary; min-width: 152px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "CALLSIGN"; color: Theme.text-secondary; min-width: 100px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "MODE"; color: Theme.text-secondary; min-width: 64px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "FREQUENCY"; color: Theme.text-secondary; min-width: 110px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "BAND"; color: Theme.text-secondary; min-width: 55px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "GRID"; color: Theme.text-secondary; min-width: 65px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "ROUTE / DETAILS"; color: Theme.text-secondary; min-width: 150px; horizontal-stretch: 1; font-size: 12px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    Text { text: "ACTIONS"; color: Theme.text-secondary; min-width: 124px; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }
            }

            if root.qsos.length == 0 : EmptyState {
                vertical-stretch: 1;
                title: "No QSOs found";
                detail: root.search-text == "" && !root.filters-applied
                    ? "Create a new QSO to start your logbook."
                    : "Try changing the current search or filters.";
            }

            if root.qsos.length > 0 : ListView {
                vertical-stretch: 1;
                for qso[index] in root.qsos : Rectangle {
                    height: 42px; background: Math.mod(index, 2) == 0 ? Theme.background : Theme.surface;
                    border-width: 1px; border-color: Theme.surface-raised; border-radius: Theme.radius-sm;
                    HorizontalBox {
                        padding-left: Theme.space-sm; padding-right: Theme.space-sm; spacing: Theme.space-xs;
                        Text { text: qso.timestamp; color: Theme.text-secondary; min-width: 152px; vertical-alignment: center; overflow: elide; }
                        Rectangle {
                            min-width: 100px;
                            Text {
                                text: qso.callsign; color: callsign-link.has-hover ? Theme.text-primary : Theme.accent;
                                font-weight: 700; vertical-alignment: center; overflow: elide;
                            }
                            callsign-link := TouchArea { clicked => { root.open-callsign-lookup(qso.callsign); } }
                        }
                        ModeBadge { mode: qso.mode; }
                        Text { text: qso.frequency; color: Theme.text-primary; min-width: 110px; vertical-alignment: center; overflow: elide; }
                        Text { text: qso.band; color: Theme.text-secondary; min-width: 55px; vertical-alignment: center; overflow: elide; }
                        Rectangle {
                            min-width: 65px;
                            Text {
                                text: qso.grid == "" ? "—" : qso.grid;
                                color: qso.grid == "" ? Theme.text-muted : grid-link.has-hover ? Theme.text-primary : Theme.accent-secondary;
                                vertical-alignment: center; overflow: elide;
                            }
                            grid-link := TouchArea {
                                enabled: qso.grid != "";
                                clicked => { root.open-grid-lookup(qso.grid); }
                            }
                        }
                        Text { text: qso.route-summary == "" ? "—" : qso.route-summary; color: Theme.text-muted; min-width: 150px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                        Button {
                        text: "Edit";
                        clicked => {
                            root.editing-id = qso.id; root.callsign-text = qso.callsign;
                            root.datetime-text = qso.datetime-input; root.mode-text = qso.mode;
                            root.mode-input-changed(qso.mode); root.frequency-text = qso.frequency-input; root.band-text = qso.band;
                            root.rst-sent-text = qso.rst-sent; root.rst-received-text = qso.rst-received;
                            root.grid-text = qso.grid; root.name-text = qso.name; root.qth-text = qso.qth;
                            root.notes-text = qso.notes; root.dmr-remote-id-text = qso.dmr-remote-id;
                            root.dmr-local-id-text = qso.dmr-local-id; root.dmr-talkgroup-text = qso.dmr-talkgroup;
                            root.dmr-timeslot-text = qso.dmr-timeslot; root.dmr-color-code-text = qso.dmr-color-code;
                            root.dmr-network-text = qso.dmr-network;
                            root.dmr-call-type-text = qso.dmr-call-type == "" ? "group" : qso.dmr-call-type;
                            root.dmr-access-type-text = qso.dmr-access-type == "" ? "simplex" : qso.dmr-access-type;
                            root.dmr-repeater-text = qso.dmr-repeater; root.dmr-hotspot-text = qso.dmr-hotspot;
                            root.dmr-notes-text = qso.dmr-notes; root.ft8-snr-sent-text = qso.ft8-snr-sent;
                            root.ft8-snr-received-text = qso.ft8-snr-received; root.ft8-power-text = qso.ft8-power;
                            root.ft8-audio-frequency-text = qso.ft8-audio-frequency;
                            root.ft8-source-software-text = qso.ft8-source-software;
                            root.ft8-protocol-text = qso.ft8-protocol == "" ? "FT8" : qso.ft8-protocol;
                            root.ft8-final-message-text = qso.ft8-final-message; root.active-page = 1;
                        }
                        }
                        Button { text: "Delete"; clicked => { root.pending-delete-id = qso.id; root.pending-delete-label = qso.callsign; } }
                    }
                }
            }

            Rectangle {
                visible: root.pending-delete-id != "";
                background: Theme.surface; border-width: 1px; border-color: Theme.danger; border-radius: Theme.radius-md;
                HorizontalBox {
                    padding: Theme.space-md; spacing: Theme.space-md;
                    VerticalBox {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Delete QSO?  " + root.pending-delete-label; color: Theme.danger; font-weight: 700; }
                        Text { text: "This action cannot be undone."; color: Theme.text-secondary; }
                    }
                    Button { text: "Cancel"; clicked => { root.pending-delete-id = ""; root.pending-delete-label = ""; } }
                    Button { text: "Confirm delete"; clicked => { root.delete-qso(root.pending-delete-id); root.pending-delete-id = ""; root.pending-delete-label = ""; } }
                }
            }
        }

        // QSO FORM
        if root.active-page == 1 : VerticalBox {
            spacing: 0px;
            Rectangle {
                height: 48px; background: Theme.surface;
                HorizontalBox {
                    padding-left: 16px; padding-right: 16px;
                    Text { text: root.editing-id == "" ? "New QSO" : "Edit QSO"; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: "* Required fields"; color: Theme.warning; vertical-alignment: center; }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 16px; spacing: 12px;
                    SectionTitle { text: "CONTACT"; }
                    HorizontalBox {
                        spacing: 10px;
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Callsign *"; color: Theme.text-primary; } LineEdit { text <=> root.callsign-text; placeholder-text: "PU2XYZ"; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; Text { text: "Date and time (UTC) *"; color: Theme.text-primary; } LineEdit { text <=> root.datetime-text; placeholder-text: "YYYY-MM-DD HH:MM:SS UTC"; } }
                        VerticalBox {
                                                    spacing: Theme.space-xs; horizontal-stretch: 2;
                                                    Text { text: "Mode *"; color: Theme.text-primary; }
                                                    LineEdit {
                                                        text <=> root.mode-text; placeholder-text: "DMR, FT8, M17...";
                                                        edited => { root.mode-input-changed(root.mode-text); }
                                                    }
                                                }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; Text { text: "Frequency (MHz) *"; color: Theme.text-primary; } LineEdit { text <=> root.frequency-text; placeholder-text: "438.500"; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Band override"; } LineEdit { text <=> root.band-text; placeholder-text: "Derived automatically when empty"; } }
                        VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Grid locator"; } LineEdit { text <=> root.grid-text; placeholder-text: "GG66AA"; } }
                    }

                    SectionTitle { text: "REPORT AND STATION DETAILS"; }
                    HorizontalBox {
                        spacing: 10px;
                        VerticalBox { spacing: 4px; Text { text: "RST sent"; } LineEdit { text <=> root.rst-sent-text; } }
                        VerticalBox { spacing: 4px; Text { text: "RST received"; } LineEdit { text <=> root.rst-received-text; } }
                        VerticalBox { spacing: 4px; Text { text: "Name"; } LineEdit { text <=> root.name-text; } }
                        VerticalBox { spacing: 4px; Text { text: "QTH"; } LineEdit { text <=> root.qth-text; } }
                    }

                    if root.mode-kind == 1 : Rectangle {
                        background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                        VerticalBox {
                            padding: Theme.space-md; spacing: Theme.space-md;
                            SectionTitle { text: "DMR DETAILS"; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Remote DMR ID"; } LineEdit { text <=> root.dmr-remote-id-text; } }
                            VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Local DMR ID"; } LineEdit { text <=> root.dmr-local-id-text; } }
                            VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Talkgroup"; } LineEdit { text <=> root.dmr-talkgroup-text; } }
                            VerticalBox { spacing: Theme.space-xs; Text { text: "Timeslot"; } LineEdit { text <=> root.dmr-timeslot-text; placeholder-text: "1 or 2"; } }
                            VerticalBox { spacing: Theme.space-xs; Text { text: "Color code"; } LineEdit { text <=> root.dmr-color-code-text; placeholder-text: "0–15"; } }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; Text { text: "Network"; } LineEdit { text <=> root.dmr-network-text; } }
                            VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 2; Text { text: "Call type"; } LineEdit { text <=> root.dmr-call-type-text; placeholder-text: "group or private"; } }
                            VerticalBox { spacing: Theme.space-xs; horizontal-stretch: 3; Text { text: "Access type"; } LineEdit { text <=> root.dmr-access-type-text; placeholder-text: "repeater, hotspot, or simplex"; } }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox { spacing: 4px; Text { text: "Repeater callsign"; } LineEdit { text <=> root.dmr-repeater-text; } }
                            VerticalBox { spacing: 4px; Text { text: "Hotspot"; } LineEdit { text <=> root.dmr-hotspot-text; } }
                            VerticalBox { spacing: 4px; horizontal-stretch: 2; Text { text: "DMR notes"; } LineEdit { text <=> root.dmr-notes-text; } }
                        }
                        }
                    }

                    if root.mode-kind == 2 : Rectangle {
                        background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                        VerticalBox {
                            padding: Theme.space-md; spacing: Theme.space-md;
                            SectionTitle { text: "FT8 DETAILS"; }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox { spacing: 4px; Text { text: "SNR sent (dB)"; } LineEdit { text <=> root.ft8-snr-sent-text; } }
                            VerticalBox { spacing: 4px; Text { text: "SNR received (dB)"; } LineEdit { text <=> root.ft8-snr-received-text; } }
                            VerticalBox { spacing: 4px; Text { text: "Power (W)"; } LineEdit { text <=> root.ft8-power-text; } }
                            VerticalBox { spacing: 4px; Text { text: "Audio frequency (Hz)"; } LineEdit { text <=> root.ft8-audio-frequency-text; } }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            VerticalBox { spacing: 4px; Text { text: "Source software"; } LineEdit { text <=> root.ft8-source-software-text; } }
                            VerticalBox { spacing: 4px; Text { text: "Protocol"; } LineEdit { text <=> root.ft8-protocol-text; } }
                            VerticalBox { spacing: 4px; Text { text: "Final message"; } LineEdit { text <=> root.ft8-final-message-text; } }
                        }
                        }
                    }

                    SectionTitle { text: "NOTES"; }
                    LineEdit { text <=> root.notes-text; placeholder-text: "Contact notes"; accepted => { root.save-qso(); } }
                    Rectangle { height: 8px; }
                }
            }
            Rectangle {
                height: 58px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                HorizontalBox {
                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Text { text: "Enter to save notes  •  Esc to cancel"; color: Theme.text-muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Cancel"; clicked => { root.clear-editor(); root.active-page = 0; } }
                    Button { text: root.editing-id == "" ? "Save QSO" : "Save changes"; primary: true; clicked => { root.save-qso(); } }
                }
            }
        }

        // TOOLS
        if root.active-page == 2 : ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                padding: 18px; spacing: 18px;
                PageTitle { text: "Tools"; }
                Rectangle {
                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                    VerticalBox {
                        padding: Theme.space-lg; spacing: Theme.space-sm;
                        SectionTitle { text: "ADIF IMPORT AND EXPORT"; }
                        Text { text: "Exchange logbook data safely. Import is transactional and export never overwrites an existing file."; color: Theme.text-secondary; }
                        HorizontalBox {
                            spacing: Theme.space-sm;
                            LineEdit { text <=> root.adif-path-text; placeholder-text: "/path/to/logbook.adi"; horizontal-stretch: 1; }
                            Button { text: "Choose import…"; clicked => { root.choose-adif-import(); } }
                            Button { text: "Choose export…"; clicked => { root.choose-adif-export(); } }
                        }
                        HorizontalBox {
                            spacing: Theme.space-sm;
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "Import ADIF"; clicked => { root.import-adif(); } }
                            Button { text: "Export ADIF"; primary: true; clicked => { root.export-adif(); } }
                        }
                    }
                }
                Rectangle {
                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                    VerticalBox {
                        padding: Theme.space-lg; spacing: Theme.space-sm;
                        SectionTitle { text: "DATABASE BACKUP"; }
                        Text { text: "Create a consistent SQLite snapshot. The destination must not already exist."; color: Theme.text-secondary; }
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit { text <=> root.backup-path-text; placeholder-text: "/path/to/logbook-backup.sqlite3"; horizontal-stretch: 1; }
                            Button { text: "Choose destination…"; clicked => { root.choose-backup-destination(); } }
                            Button { text: "Create backup"; primary: true; clicked => { root.backup-database(); } }
                        }
                    }
                }
            }
        }

        // SETTINGS
        if root.active-page == 3 : ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                padding: 18px; spacing: 16px;
                PageTitle { text: "Settings"; }
                Rectangle {
                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                    VerticalBox {
                        padding: Theme.space-lg; spacing: Theme.space-sm;
                        SectionTitle { text: "LOCAL STATION"; }
                        Text { text: "Identify this station in the application header. The callsign is stored in the local XDG configuration directory."; color: Theme.text-secondary; }
                        HorizontalBox {
                            spacing: 8px;
                            LineEdit { text <=> root.local-callsign-text; placeholder-text: "Local callsign"; }
                            Button { text: "Save station"; primary: true; clicked => { root.save-local-callsign(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                Rectangle {
                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
                    VerticalBox {
                        padding: Theme.space-lg; spacing: Theme.space-sm;
                        SectionTitle { text: "EXTERNAL LOOKUP LINKS"; }
                        Text {
                            text: "Opening a lookup sends the selected callsign or grid locator to the configured external website.";
                            color: Theme.warning;
                        }
                        VerticalBox {
                            spacing: Theme.space-xs;
                            Text { text: "Callsign URL template — requires {callsign}"; }
                            LineEdit { text <=> root.callsign-url-text; horizontal-stretch: 1; }
                        }
                        VerticalBox {
                            spacing: Theme.space-xs;
                            Text { text: "Grid URL template — requires {grid}"; }
                            LineEdit { text <=> root.grid-url-text; horizontal-stretch: 1; }
                        }
                        HorizontalBox {
                            spacing: Theme.space-sm;
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "Restore defaults"; clicked => { root.restore-external-link-defaults(); } }
                            Button { text: "Save links"; primary: true; clicked => { root.save-external-links(); } }
                        }
                    }
                }
                Text { text: "Data remains local. External websites open only after an explicit click."; color: Theme.success; }
            }
        }

        StatusBar { message: root.status-text; kind: root.status-kind; }
    }
}
