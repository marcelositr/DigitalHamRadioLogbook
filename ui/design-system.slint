import { HorizontalBox, LineEdit, Palette, StyleMetrics, VerticalBox } from "std-widgets.slint";

// Minimal application primitives. Visual appearance comes from the selected Slint style.
// These components add semantics and layout only; they do not define a parallel theme.

export component FormField inherits VerticalBox {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> input-accessible-label;
    in property <bool> field-enabled: true;
    callback accepted();
    callback edited();

    padding: 0px;
    spacing: StyleMetrics.layout-spacing / 2;

    Text {
        text: root.label;
    }

    input := LineEdit {
        text <=> root.text;
        placeholder-text: root.placeholder-text;
        accessible-label: root.input-accessible-label == "" ? root.label : root.input-accessible-label;
        enabled: root.field-enabled;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    public function focus-editor() {
        input.focus();
    }
}

export component TextAction inherits Rectangle {
    in property <string> text;
    in property <string> description;
    callback activated();

    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-action-default => { root.activated(); }

    min-width: label.preferred-width;
    min-height: label.preferred-height + 6px;
    background: pointer.has-hover ? Palette.background.darker(0.08) : transparent;

    label := Text {
        text: root.text;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    pointer := TouchArea {
        clicked => {
            focus.focus();
            root.activated();
        }
    }
}

export component EmptyState inherits VerticalBox {
    in property <string> title;
    in property <string> detail;

    alignment: center;
    spacing: StyleMetrics.layout-spacing;

    Text {
        text: root.title;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        text: root.detail;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component StatusBar inherits Rectangle {
    in property <string> message;
    in property <int> kind; // 0 info, 1 success, 2 warning, 3 error

    accessible-role: content-info;
    accessible-label: root.message;
    accessible-live-region: polite;

    height: content.preferred-height;
    vertical-stretch: 0;
    background: Palette.background.darker(0.05);

    content := HorizontalBox {
        padding-left: StyleMetrics.layout-padding;
        padding-right: StyleMetrics.layout-padding;
        padding-top: StyleMetrics.layout-spacing / 2;
        padding-bottom: StyleMetrics.layout-spacing / 2;

        Text {
            text: root.kind == 3 ? "Error"
                : root.kind == 2 ? "Notice"
                : root.kind == 1 ? "Done"
                : "Status";
            font-weight: 600;
        }

        Text {
            text: root.message;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}
