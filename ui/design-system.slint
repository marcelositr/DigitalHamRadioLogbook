// Material 3-inspired visual system adapted for dense desktop radio work.
// The product uses tonal surfaces, restrained accent color and consistent state layers.
import { HorizontalBox, VerticalBox } from "std-widgets.slint";

export global Theme {
    // Material-style surface roles. Dark, neutral and deliberately low-chroma.
    out property <color> background: #111418;
    out property <color> surface: #171b20;
    out property <color> surface-raised: #1d2228;
    out property <color> surface-hover: #242a31;
    out property <color> surface-selected: #20323a;

    // Outline and focus roles.
    out property <color> border: #384149;
    out property <color> border-subtle: #292f36;
    out property <color> divider: #252b31;
    out property <color> focus: #8ac7d8;

    // On-surface type roles.
    out property <color> text-primary: #e5e9ed;
    out property <color> text-secondary: #b7bec5;
    out property <color> text-muted: #858f98;
    out property <color> text-disabled: #626b73;

    // Product accent. Used for actions, focus and selection, never decoration.
    out property <color> accent: #72b2c4;
    out property <color> accent-strong: #a8d6e1;
    out property <color> accent-secondary: #6a9baa;
    out property <color> primary: #2f697a;
    out property <color> primary-hover: #397b8f;

    // Operational semantic roles.
    out property <color> danger: #e49a9f;
    out property <color> danger-surface: #352326;
    out property <color> warning: #d7ba7b;
    out property <color> warning-surface: #332d21;
    out property <color> success: #94bf92;
    out property <color> success-surface: #233027;
    out property <color> info-surface: #1d2b31;
    out property <color> special: #b0a2bf;

    // 4 px desktop spacing grid.
    out property <length> space-2xs: 4px;
    out property <length> space-xs: 8px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;

    // Restrained Material geometry for desktop density.
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;

    // Compact desktop type scale.
    out property <length> text-xs: 11px;
    out property <length> text-sm: 12px;
    out property <length> text-md: 14px;
    out property <length> text-lg: 17px;
    out property <length> text-xl: 21px;
    out property <length> callsign-size: 15px;
    out property <length> technical-size: 13px;
}

export component KeyboardAction inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> active: false;
    in property <bool> link: false;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> compact: false;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    border-width: action-focus.has-focus ? 2px : root.link || root.primary ? 0px : 1px;
    border-color: action-focus.has-focus ? Theme.focus : root.active ? Theme.accent-secondary : root.danger ? Theme.danger : Theme.border;
    min-height: root.link ? 22px : root.compact ? 28px : 32px;
    max-height: root.link ? 22px : root.compact ? 28px : 32px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.surface
        : root.link ? transparent
        : root.danger ? pointer.has-hover ? Theme.danger : Theme.danger-surface
        : root.primary ? pointer.has-hover ? Theme.primary-hover : Theme.primary
        : root.active ? Theme.surface-selected
        : pointer.has-hover ? Theme.surface-hover : Theme.surface;

    Text {
        text: root.label;
        color: !root.enabled ? Theme.text-disabled
            : root.link ? pointer.has-hover || action-focus.has-focus ? Theme.text-primary : Theme.accent
            : root.danger && pointer.has-hover ? Theme.background
            : Theme.text-primary;
        font-size: root.compact ? Theme.text-xs : Theme.text-sm;
        font-weight: root.active || root.primary ? 600 : root.link ? 550 : 500;
        horizontal-alignment: root.link ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }
    action-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        enabled: root.enabled;
        clicked => { action-focus.focus(); root.activated(); }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    callback accepted();
    callback edited();

    accessible-role: search;
    accessible-label: "Search logbook";
    height: 36px;
    min-width: 240px;
    clip: true;
    background: Theme.surface;
    border-width: search-input.has-focus ? 2px : 1px;
    border-color: search-input.has-focus ? Theme.focus : Theme.border;
    border-radius: Theme.radius-sm;

    Text {
        x: Theme.space-md;
        width: parent.width - Theme.space-xl;
        text: root.text == "" ? root.placeholder-text : "";
        color: Theme.text-muted;
        font-size: Theme.text-sm;
        vertical-alignment: center;
        overflow: elide;
    }
    search-input := TextInput {
        x: Theme.space-md;
        width: parent.width - Theme.space-xl;
        text <=> root.text;
        color: Theme.text-primary;
        selection-foreground-color: Theme.background;
        selection-background-color: Theme.accent;
        font-size: Theme.text-sm;
        vertical-alignment: center;
        single-line: true;
        accessible-label: "Search by callsign or mode";
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
}

export component Panel inherits Rectangle {
    in property <bool> raised: false;
    background: raised ? Theme.surface-raised : transparent;
    border-width: raised ? 1px : 0px;
    border-color: Theme.border-subtle;
    border-radius: Theme.radius-md;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    min-width: 48px;
    background: accent ? Theme.surface-selected : Theme.surface-raised;
    border-radius: Theme.radius-sm;
    Text {
        text: root.text;
        color: accent ? Theme.accent-strong : Theme.text-secondary;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    background: selected ? Theme.surface-selected : Theme.surface;
    border-width: 1px;
    border-color: selected ? Theme.accent-secondary : Theme.border;
    border-radius: Theme.radius-sm;
    HorizontalBox {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        Text {
            text: root.text;
            color: selected ? Theme.accent-strong : Theme.text-secondary;
            font-size: Theme.text-xs;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component DataLabel inherits Text {
    color: Theme.text-muted;
    font-size: Theme.text-xs;
    font-weight: 550;
    vertical-alignment: center;
}

export component TechnicalValue inherits Text {
    color: Theme.text-primary;
    font-size: Theme.technical-size;
    font-weight: 550;
    vertical-alignment: center;
    overflow: elide;
}

export component SectionTitle inherits Text {
    color: Theme.text-primary;
    font-size: Theme.text-md;
    font-weight: 600;
    vertical-alignment: center;
}

export component PageTitle inherits Text {
    color: Theme.text-primary;
    font-size: Theme.text-xl;
    font-weight: 650;
    vertical-alignment: center;
}

export component StationBadge inherits Rectangle {
    in property <string> callsign;

    background: transparent;
    border-width: 0px;
    border-radius: Theme.radius-sm;

    HorizontalBox {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-sm;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: callsign == "" ? Theme.warning : Theme.success;
        }
        Text {
            text: callsign == "" ? "Station not set" : callsign;
            color: callsign == "" ? Theme.warning : Theme.text-primary;
            font-size: Theme.text-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
        if callsign != "" : Text {
            text: "Local";
            color: Theme.text-muted;
            font-size: Theme.text-xs;
            vertical-alignment: center;
        }
    }
}

export component ModeBadge inherits Rectangle {
    in property <string> mode;

    min-width: 54px;
    max-width: 54px;
    background: mode == "DMR" ? Theme.surface-selected : mode == "FT8" ? Theme.success-surface : Theme.surface-raised;
    border-width: 0px;
    border-radius: Theme.radius-sm;

    Text {
        text: mode;
        color: mode == "DMR" ? Theme.accent-strong : mode == "FT8" ? Theme.success : Theme.text-secondary;
        font-size: Theme.text-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component EmptyState inherits VerticalBox {
    in property <string> title;
    in property <string> detail;

    alignment: center;
    spacing: Theme.space-sm;

    Text {
        text: title;
        color: Theme.text-primary;
        font-size: Theme.text-lg;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: detail;
        color: Theme.text-muted;
        font-size: Theme.text-sm;
        horizontal-alignment: center;
    }
}

export component StatusBar inherits Rectangle {
    in property <string> message;
    in property <int> kind; // 0 info, 1 success, 2 warning, 3 error

    accessible-role: content-info;
    accessible-label: message;
    accessible-live-region: polite;
    height: 30px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalBox {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;

        Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 3px;
            background: kind == 3 ? Theme.danger : kind == 2 ? Theme.warning : kind == 1 ? Theme.success : Theme.text-muted;
        }
        Text {
            text: kind == 3 ? "Error" : kind == 2 ? "Notice" : kind == 1 ? "Complete" : "Local database";
            color: kind == 3 ? Theme.danger : kind == 2 ? Theme.warning : kind == 1 ? Theme.success : Theme.text-muted;
            font-size: Theme.text-xs;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: message;
            color: Theme.text-secondary;
            font-size: Theme.text-xs;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
